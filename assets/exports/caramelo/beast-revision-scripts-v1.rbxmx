<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
<Item class="Model" referent="RBX0"><Properties><string name="Name">BeastRevisionScripts</string></Properties>
<Item class="ModuleScript" referent="RBX1"><Properties><string name="Name">WildboundBeastStreamer_Test</string><ProtectedString name="Source"><![CDATA[-- Invoke with require(freshTestClone)(require(freshBeastEncountersClone), require(freshBeastStreamerClone),
-- require(freshBeastConfigClone), freshBeastStreamerClone.Source).
-- Beast revision BR3 (odd/tasks/wildbound-beast-revision.md): the Screamer (internal id Streamer), pure. A fake world
-- (flat ground at y 0, open lines unless a case closes them, nearSpot and safe answered by the case) and a fake dodge
-- stand in for the beast script; the target is a table moved by each case. No world is touched.
return function(Enc, Streamer, Config, source)
	local result = { passed = 0, failed = 0, messages = {} }
	local function case(name, run)
		local ok, message = pcall(run)
		if ok then result.passed += 1 else
			result.failed += 1
			table.insert(result.messages, name .. ": " .. tostring(message))
		end
	end
	local function equal(actual, expected, label)
		assert(actual == expected, (label and label .. ": " or "") .. "expected " .. tostring(expected) .. ", got " .. tostring(actual))
	end
	local function near(actual, expected, label, tolerance)
		assert(type(actual) == "number" and math.abs(actual - expected) <= (tolerance or 1e-6),
			(label and label .. ": " or "") .. "expected " .. tostring(expected) .. ", got " .. tostring(actual))
	end
	Enc.register("Streamer", Streamer)
	local C = Config.BEASTS.Streamer

	local function fakeWorld()
		local w = { telegraphs = {}, resolved = {}, cancelled = {}, verdict = "Hit", los = true, spot = nil, safeX = math.huge }
		function w.ground() return 0 end
		function w.lineOfSight() return w.los end
		function w.nearSpot() return w.spot end
		function w.safe(x) return x >= w.safeX end
		function w.telegraph(id, beast, startAt, strikeAt)
			table.insert(w.telegraphs, { id = id, beast = beast, startAt = startAt, strikeAt = strikeAt })
			return strikeAt - startAt >= 0.8 - 1e-9
		end
		function w.resolve(id) table.insert(w.resolved, id); return w.verdict end
		function w.cancel(id) table.insert(w.cancelled, id) end
		return w
	end
	local function target(x, z) return { x = x, y = 3, z = z, vx = 0, vz = 0, alive = true, safe = false } end
	local function run(e, w, tgt, from, to, move)
		local all = {}
		for i = 0, math.floor((to - from) / 0.05 + 1e-6) do
			local t = from + i * 0.05
			if move then move(t, tgt) end
			for _, ev in ipairs(Enc.step(e, t, tgt, w)) do table.insert(all, ev) end
		end
		return all
	end
	local function find(events, kind, field, value)
		for _, ev in ipairs(events) do
			if ev.type == kind and (field == nil or ev[field] == value) then return ev end
		end
		return nil
	end
	local function count(events, kind, field, value)
		local n = 0
		for _, ev in ipairs(events) do
			if ev.type == kind and (field == nil or ev[field] == value) then n += 1 end
		end
		return n
	end
	-- A Screamer woken at the origin: the target steps in at 10 studs, then the scream runs out.
	local function woken(w, tgt, id)
		local e = Enc.new("Streamer", id, 1, 0, { x = 0, y = 0, z = -10 })
		run(e, w, tgt, 0, C.screamSeconds + 0.1)
		equal(e.phase, "Pursue", "chasing after the scream")
		return e
	end

	case("BR3 Screamer: the display name is Screamer; the internal id stays Streamer", function()
		equal(C.displayName, "Screamer")
		assert(Config.PLAYABLE.Streamer and Config.WAVE2.Streamer, "the id still plugs in")
	end)

	case("BR3 Screamer: a statue until the activation distance: it never moves, tells or hits", function()
		local w = fakeWorld()
		local tgt = target(0, 0)
		local e = Enc.new("Streamer", "beast:1", 1, 0, { x = 0, y = 0, z = -40 })
		local events = run(e, w, tgt, 0, 20)
		equal(e.phase, "Statue")
		near(e.pos.z, -40, "did not move"); near(e.pos.x, 0)
		equal(count(events, "Tell"), 0); equal(count(events, "Hit"), 0); equal(count(events, "Move"), 0)
		assert(C.activationDistance > 0, "configurable activation distance")
	end)

	case("BR3 Screamer: within the activation distance it screams (harmless), then chases", function()
		local w = fakeWorld()
		local tgt = target(0, 0)
		local e = Enc.new("Streamer", "beast:2", 1, 0, { x = 0, y = 0, z = -40 })
		local events = run(e, w, tgt, 0, 8, function(t, tg)
			if t >= 2 then tg.z = -40 + C.activationDistance - 1 end
			if e.phase == "Scream" then tg.z = e.pos.z + 1 end -- right on top of it during the scream
		end)
		local scream = find(events, "Phase", "phase", "Scream")
		assert(scream, "it screams")
		near(scream.untilAt - scream.at, C.screamSeconds)
		local pursue = find(events, "Phase", "phase", "Pursue")
		near(pursue.at, scream.at + C.screamSeconds, "then chases")
		for _, ev in ipairs(events) do
			if ev.at < pursue.at then
				assert(ev.type ~= "Hit" and ev.type ~= "Tell", "the scream never hurts or tells: " .. ev.type)
			end
		end
	end)

	case("BR3 Screamer: the chase is very fast (chaseSpeed) and no rush exists", function()
		assert(C.chaseSpeed > 24, "faster than a trained runner")
		local w = fakeWorld()
		local tgt = target(0, 0)
		local e = woken(w, tgt, "beast:3")
		tgt.z = 30
		local z0 = e.pos.z
		run(e, w, tgt, 1.5, 2.0)
		near(e.pos.z - z0, C.chaseSpeed * 0.5, "26 studs a second", 0.6)
		local events = run(e, w, tgt, 2.05, 8)
		equal(find(events, "Move", "kind", "dash"), nil, "no rush")
	end)

	case("BR3 Screamer: reaching the target opens a dodgeable 0.8 s grab; standing still is one 28-damage hit", function()
		local w = fakeWorld()
		local tgt = target(0, 0)
		local e = woken(w, tgt, "beast:4")
		local events = run(e, w, tgt, 1.5, 5)
		local tell = find(events, "Tell")
		assert(tell and tell.shape.kind == "circle", "the grab circle")
		equal(tell.shape.r, C.catchRadius)
		near(tell.strikeAt - tell.startAt, C.catchTell)
		assert(C.catchTell >= Config.MIN_TELL, "never under the 0.8 s floor")
		equal(w.telegraphs[1].beast, "Streamer", "registered with the dodge")
		equal(count(events, "Hit"), 1)
		equal(find(events, "Hit").damage, C.catchDamage)
		assert(find(events, "Phase", "phase", "Recovery"), "a recovery after the grab")
	end)

	case("BR3 Screamer: stepping out after the grab locks is a miss", function()
		local w = fakeWorld()
		local tgt = target(0, 0)
		local e = woken(w, tgt, "beast:5")
		local events = run(e, w, tgt, 1.5, 5, function(_, tg)
			if e.catch and e.catch.lockedNow then tg.x = 9 end
		end)
		equal(count(events, "Hit"), 0)
		equal(w.cancelled[1], w.telegraphs[1].id, "the dodge registration is cancelled")
	end)

	case("BR3 Screamer: lost far away it teleports to a valid spot near the target, then waits the cooldown", function()
		local w = fakeWorld()
		local tgt = target(0, 0)
		local e = woken(w, tgt, "beast:6")
		tgt.z = 200
		w.spot = { x = 0, y = 0, z = 200 - 18 }
		local events = run(e, w, tgt, 1.5, 1.6)
		local blink = find(events, "Move", "kind", "blink")
		assert(blink, "a teleport")
		near(blink.to.z, 182)
		near(e.pos.z, 182, "it moved there")
		equal(count(events, "Hit"), 0, "a teleport never hits")
		assert(e.catchReadyAt >= blink.at + C.teleportGrabBlock - 1e-6, "the grab waits after a jump")
		-- Far again at once: no second jump before the cooldown.
		tgt.z = 600
		w.spot = { x = 0, y = 0, z = 600 - 18 }
		local later = run(e, w, tgt, 1.65, 1.5 + C.teleportCooldown - 0.2)
		equal(count(later, "Move", "kind", "blink"), 0, "cooldown")
	end)

	case("BR3 Screamer: no teleport into a safe zone, onto the target, under the map or with no spot; the chase goes on", function()
		for _, spec in ipairs({
			{ spot = { x = 0, y = 0, z = 182 }, safeX = -1, why = "Safe" },
			{ spot = { x = 0, y = 0, z = 198 }, why = "Near" },
			{ spot = { x = 0, y = 0 / 0, z = 182 }, why = "NoSpot" },
			{ spot = nil, why = "NoSpot" },
		}) do
			local w = fakeWorld()
			local tgt = target(0, 0)
			local e = woken(w, tgt, "beast:7" .. spec.why)
			tgt.z = 200
			w.spot, w.safeX = spec.spot, spec.safeX or math.huge
			local z0 = e.pos.z
			local events = run(e, w, tgt, 1.5, 3)
			equal(count(events, "Move", "kind", "blink"), 0, spec.why .. ": no jump")
			equal(find(events, "TeleportRefused").reason, spec.why)
			assert(e.pos.z > z0 + 10, spec.why .. ": it kept running")
			equal(e.phase, "Pursue")
		end
	end)

	case("BR3 Screamer: out of sight for 2 s it may reposition; never before it is chasing", function()
		local w = fakeWorld()
		w.los = false
		w.spot = { x = 0, y = 0, z = -40 }
		local tgt = target(0, 0)
		local e = Enc.new("Streamer", "beast:8", 1, 0, { x = 0, y = 0, z = -60 })
		local statue = run(e, w, tgt, 0, 5)
		equal(count(statue, "Move"), 0, "a statue never teleports")
		tgt.z = -60 + 10
		run(e, w, tgt, 5.05, 5.05 + C.screamSeconds + 0.1)
		tgt.z = -60 + 20
		w.spot = { x = 0, y = 0, z = tgt.z - 16 }
		local events = run(e, w, tgt, 6.6, 6.6 + C.teleportUnseenSeconds + 0.3, function(_, tg) tg.z = e.pos.z + 20; w.spot = { x = 0, y = 0, z = tg.z - 16 } end)
		assert(find(events, "Move", "kind", "blink"), "repositioned after 2 s unseen")
	end)

	case("BR3 Screamer: an unwoken statue ends quietly; a woken one never times out (persistent chase)", function()
		local w = fakeWorld()
		local tgt = target(0, 0)
		local e = Enc.new("Streamer", "beast:9", 1, 0, { x = 0, y = 0, z = -60 })
		local events = run(e, w, tgt, 0, C.statueSeconds + 2)
		equal(find(events, "Disengage").reason, "Unwoken")
		assert(find(events, "End"), "it ends")
		local w2 = fakeWorld()
		local tgt2 = target(0, 0)
		local e2 = woken(w2, tgt2, "beast:10")
		local later = run(e2, w2, tgt2, 1.5, 100, function(_, tg) tg.z = e2.pos.z + 30 end)
		equal(find(later, "Disengage"), nil); equal(find(later, "End"), nil)
	end)

	case("BR3 Screamer: a safe zone or a death ends it at once; open attacks are left for closeAll", function()
		local w = fakeWorld()
		local tgt = target(0, 0)
		local e = woken(w, tgt, "beast:11")
		run(e, w, tgt, 1.5, 1.7)
		equal(e.phase, "CatchTell", "mid-grab")
		tgt.safe = true
		local events = Enc.step(e, 1.75, tgt, w)
		equal(find(events, "End").reason, "SafeZone")
		equal(count(events, "Hit"), 0, "no hit on the way out")
		local e2 = Enc.new("Streamer", "beast:12", 1, 0, { x = 0, y = 0, z = -20 })
		equal(find(Enc.step(e2, 0.05, nil, w), "End").reason, "Death", "no body: death")
	end)

	case("BR3 Screamer: the module is pure and server-only", function()
		for _, banned in ipairs({ "workspace", "game:", "task.", "os.clock", "math.random", "Random.new", "Touched", "FireClient" }) do
			assert(not source:find(banned, 1, true), "source uses " .. banned)
		end
	end)

	return result
end]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX2"><Properties><string name="Name">WildboundBeastGaze_Test</string><ProtectedString name="Source"><![CDATA[-- Invoke with require(freshTestClone)(require(freshBeastEncountersClone), require(freshBeastGazeClone),
-- require(freshBeastConfigClone), freshBeastGazeClone.Source).
-- Beast revision BR5 (odd/tasks/wildbound-beast-revision.md): Gaze's accumulated-look defeat, pure. target.observe stands
-- in for the beast script's validated observation (WildboundBeastSight plus the server raycast line of sight); each
-- case says when the target looks (a wall is "observe returns false": the server raycast is part of observe).
return function(Enc, Gaze, Config, source)
	local result = { passed = 0, failed = 0, messages = {} }
	local function case(name, run)
		local ok, message = pcall(run)
		if ok then result.passed += 1 else
			result.failed += 1
			table.insert(result.messages, name .. ": " .. tostring(message))
		end
	end
	local function equal(actual, expected, label)
		assert(actual == expected, (label and label .. ": " or "") .. "expected " .. tostring(expected) .. ", got " .. tostring(actual))
	end
	local function near(actual, expected, label, tolerance)
		assert(type(actual) == "number" and math.abs(actual - expected) <= (tolerance or 1e-6),
			(label and label .. ": " or "") .. "expected " .. tostring(expected) .. ", got " .. tostring(actual))
	end
	Enc.register("Gaze", Gaze)
	local C = Config.BEASTS.Gaze
	local T = C.tuning

	local function fakeWorld()
		local w = { spots = 0 }
		function w.ground() return 0 end
		function w.reposition() w.spots += 1; return { x = 0, y = 0, z = -40 } end
		return w
	end
	local function target(looking)
		local tgt = { x = 0, y = 3, z = 0, alive = true, safe = false, biomes = {}, calls = {}, now = 0 }
		tgt.observe = function(point, halfAngle, maxDist, favour)
			table.insert(tgt.calls, { point = point, halfAngle = halfAngle, maxDist = maxDist, favour = favour })
			return looking(tgt.now)
		end
		return tgt
	end
	local function run(e, w, tgt, from, to, move)
		local all = {}
		for i = 0, math.floor((to - from) / 0.05 + 1e-6) do
			local t = from + i * 0.05
			tgt.now = t
			if move then move(t, tgt) end
			for _, ev in ipairs(Enc.step(e, t, tgt, w)) do table.insert(all, ev) end
		end
		return all
	end
	local function find(events, kind, field, value)
		for _, ev in ipairs(events) do
			if ev.type == kind and (field == nil or ev[field] == value) then return ev end
		end
		return nil
	end
	local function count(events, kind)
		local n = 0
		for _, ev in ipairs(events) do if ev.type == kind then n += 1 end end
		return n
	end
	local function always(value) return function() return value end end
	local M = C.manifestSeconds

	case("BR5 Gaze: the threshold is 3 s (configurable) and the result is one 100-damage defeat", function()
		equal(C.killSeconds, 3); equal(C.killDamage, 100)
	end)

	case("BR5 Gaze: manifests first (nothing counts), then counts only while really observed, through the eyes", function()
		local w, tgt = fakeWorld(), target(always(true))
		local e = Enc.new("Gaze", "beast:1", 1, 0, { x = 0, y = 0, z = -40 })
		local events = run(e, w, tgt, 0, M)
		equal(#tgt.calls, 0, "not read while it manifests")
		equal(count(events, "Hit"), 0)
		run(e, w, tgt, M + 0.05, M + 1)
		local call = tgt.calls[1]
		equal(call.halfAngle, T.SightConeDegrees); equal(call.maxDist, T.MaxViewDistanceStuds)
		equal(call.favour, false, "lag never counts")
		near(call.point.y, C.eyeHeight, "the cone aims at the eyes")
		near(e.exposure, 1, "about 1 s", 0.06)
	end)

	case("BR5 Gaze: 3 s of continuous looking is exactly one instant defeat", function()
		local w, tgt = fakeWorld(), target(always(true))
		local e = Enc.new("Gaze", "beast:2", 1, 0, { x = 0, y = 0, z = -40 })
		local events = run(e, w, tgt, 0, M + 10)
		equal(count(events, "Hit"), 1, "once per encounter")
		local hit = find(events, "Hit")
		equal(hit.damage, C.killDamage); equal(hit.kill, true)
		near(hit.at, M + C.killSeconds, "at 3 s of looking", 0.06)
		equal(count(events, "Tell"), 0, "no zone, no gradual damage")
	end)

	case("BR5 Gaze: two separate looks add up; looking away pauses (never resets) the count", function()
		local w = fakeWorld()
		-- 2 s looking, 3 s away, then looking again: the defeat comes 1 s into the second look.
		local tgt = target(function(t) return (t >= M and t < M + 2) or t >= M + 5 end)
		local e = Enc.new("Gaze", "beast:3", 1, 0, { x = 0, y = 0, z = -40 })
		local events = run(e, w, tgt, 0, M + 4.9)
		near(e.exposure, 2, "held while away", 0.06)
		equal(count(events, "Hit"), 0)
		local paused = find(events, "Exposure", "paused", true)
		assert(paused and math.abs(paused.value - 2 / 3) < 0.05, "the meter shows a paused count")
		local later = run(e, w, tgt, M + 4.95, M + 8)
		local hit = find(later, "Hit")
		assert(hit, "the second look completes it")
		near(hit.at, M + 6, "2 s + 1 s", 0.06)
	end)

	case("BR5 Gaze: a wall (no line of sight, observe false) never counts", function()
		local w, tgt = fakeWorld(), target(always(false))
		local e = Enc.new("Gaze", "beast:4", 1, 0, { x = 0, y = 0, z = -40 })
		local events = run(e, w, tgt, 0, M + 20)
		near(e.exposure, 0, "nothing through the wall")
		equal(count(events, "Hit"), 0)
	end)

	case("BR5 Gaze: progressive feedback: the meter rises while looked at and says paused when not", function()
		local w = fakeWorld()
		local tgt = target(function(t) return t < M + 1.5 end)
		local e = Enc.new("Gaze", "beast:5", 1, 0, { x = 0, y = 0, z = -40 })
		local events = run(e, w, tgt, 0, M + 2.5)
		local last = -1
		for _, ev in ipairs(events) do
			if ev.type == "Exposure" and not ev.paused then
				assert(ev.value >= last - 1e-9, "never goes down"); last = ev.value
				assert(ev.value >= 0 and ev.value <= 1, "0 to 1")
			end
		end
		assert(last > 0.4, "it rose")
		assert(find(events, "Exposure", "paused", true), "paused once the look stopped")
		assert(find(events, "Phase", "phase", "ExposureBuild") and find(events, "SightBreak"), "posture and break cues")
	end)

	case("BR5 Gaze: spent after the defeat (normal mode keeps the target alive): no second strike, no exit", function()
		local w, tgt = fakeWorld(), target(always(true))
		local e = Enc.new("Gaze", "beast:6", 1, 0, { x = 0, y = 0, z = -40 })
		local events = run(e, w, tgt, 0, M + 60)
		equal(count(events, "Hit"), 1)
		equal(find(events, "Disengage"), nil); equal(find(events, "End"), nil)
	end)

	case("BR5 Gaze: a new encounter starts the count from zero; a safe zone ends it at once", function()
		local w, tgt = fakeWorld(), target(always(true))
		local e = Enc.new("Gaze", "beast:7", 1, 0, { x = 0, y = 0, z = -40 })
		run(e, w, tgt, 0, M + 2)
		tgt.safe = true
		equal(find(Enc.step(e, M + 2.05, tgt, w), "End").reason, "SafeZone")
		local e2 = Enc.new("Gaze", "beast:8", 1, 0, { x = 0, y = 0, z = -40 })
		equal(e2.exposure, 0, "fresh count")
	end)

	case("BR5 Gaze: unobserved and out of view range it reappears in range (persistent), at most every 3 s", function()
		local w, tgt = fakeWorld(), target(always(false))
		local e = Enc.new("Gaze", "beast:9", 1, 0, { x = 0, y = 0, z = -40 })
		run(e, w, tgt, 0, M + 0.1)
		tgt.z = 200
		local events = run(e, w, tgt, M + 0.15, M + 7, function(_, tg) tg.z = 200 end)
		local blinks = count(events, "Move")
		assert(blinks >= 1 and blinks <= 3, "repositioned, throttled: " .. blinks)
		equal(find(events, "Disengage"), nil, "never gives up")
	end)

	case("BR5 Gaze: the module is pure and server-only", function()
		for _, banned in ipairs({ "workspace", "game:", "task.", "os.clock", "math.random", "Random.new", "Touched", "FireClient" }) do
			assert(not source:find(banned, 1, true), "source uses " .. banned)
		end
	end)

	return result
end]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX3"><Properties><string name="Name">WildboundBeastRoot_Test</string><ProtectedString name="Source"><![CDATA[-- Invoke with require(freshTestClone)(require(freshBeastEncountersClone), require(freshBeastRootClone),
-- require(freshBeastConfigClone), freshBeastRootClone.Source).
-- Wave 2 (odd/tasks/wildbound-beasts-wave2.md, BW2-5): Root's state machine, pure, with a fake world (flat ground at
-- y 0) and a fake dodge. The target stands in the Pantano (biomes.Swamp) unless a case moves it out.
return function(Enc, Root, Config, source)
	local result = { passed = 0, failed = 0, messages = {} }
	local function case(name, run)
		local ok, message = pcall(run)
		if ok then result.passed += 1 else
			result.failed += 1
			table.insert(result.messages, name .. ": " .. tostring(message))
		end
	end
	local function equal(actual, expected, label)
		assert(actual == expected, (label and label .. ": " or "") .. "expected " .. tostring(expected) .. ", got " .. tostring(actual))
	end
	local function near(actual, expected, label, tolerance)
		assert(type(actual) == "number" and math.abs(actual - expected) <= (tolerance or 1e-6),
			(label and label .. ": " or "") .. "expected " .. tostring(expected) .. ", got " .. tostring(actual))
	end
	Enc.register("Root", Root)
	local C = Config.BEASTS.Root
	local T = C.tuning

	local function fakeWorld()
		local w = { telegraphs = {}, resolved = {}, cancelled = {}, verdict = "Hit", gapOpen = true }
		function w.ground() return 0 end
		function w.landing() return 0 end
		function w.safe() return false end
		function w.gapClear() return w.gapOpen end
		function w.telegraph(id, beast, startAt, strikeAt)
			table.insert(w.telegraphs, { id = id, beast = beast, startAt = startAt, strikeAt = strikeAt })
			return true
		end
		function w.resolve(id) table.insert(w.resolved, id); return w.verdict end
		function w.cancel(id) table.insert(w.cancelled, id) end
		return w
	end
	local function target(x, z) return { x = x, y = 3, z = z, alive = true, safe = false, biomes = { Swamp = true } } end
	local function run(e, w, tgt, from, to, move)
		local all = {}
		-- Times from a step index, so 0.05 s steps never drift.
		for i = 0, math.floor((to - from) / 0.05 + 1e-6) do
			local t = from + i * 0.05
			if move then move(t, tgt) end
			for _, ev in ipairs(Enc.step(e, t, tgt, w)) do table.insert(all, ev) end
		end
		return all
	end
	local function find(events, kind, field, value)
		for _, ev in ipairs(events) do
			if ev.type == kind and (field == nil or ev[field] == value) then return ev end
		end
		return nil
	end
	local function tellOf(events, kind)
		for _, ev in ipairs(events) do
			if ev.type == "Tell" and ev.shape and ev.shape.kind == kind then return ev end
		end
		return nil
	end
	local function hitsFor(events, id)
		local list = {}
		for _, ev in ipairs(events) do if ev.type == "Hit" and ev.attack == id then table.insert(list, ev) end end
		return list
	end

	case("BW2 Root: rises, then the trap: fixed lanes 4 studs wide, at most 12 segments, 0.9 s before the eruption (BR4, was 1.15)", function()
		local w = fakeWorld()
		local tgt = target(0, 0)
		local e = Enc.new("Root", "beast:1", 1, 0, { x = 0, y = 0, z = -20 })
		local events = run(e, w, tgt, 0, 3, function(t, tg)
			if t > 1.5 then tg.x = 0.5 end -- a small step: the lanes never follow
		end)
		local rise = find(events, "Phase", "phase", "Rise")
		near(rise.untilAt - rise.at, C.spawnSeconds)
		local tell = tellOf(events, "multi")
		assert(tell, "the trap tell")
		near(tell.at, C.spawnSeconds, "after the rise", 0.051)
		near(tell.strikeAt - tell.startAt, C.trapTelegraph)
		equal(#tell.shape.list, C.trapLanes)
		assert(#tell.shape.list * tell.shape.segments <= T.MaxActiveRootSegments, "segment budget")
		for _, lane in ipairs(tell.shape.list) do equal(lane.width, T.TrapLaneWidthStuds) end
		equal(w.telegraphs[1].id, tell.tell, "registered with the dodge")
		for _, ev in ipairs(events) do
			if ev.type == "Tell" and ev.tell == tell.tell then equal(ev.shape, tell.shape, "the lanes never move") end
		end
	end)

	case("BW2 Root: one eruption hit with damage and the slow, even standing in the lane for the whole window", function()
		local w = fakeWorld()
		local tgt = target(0, 0)
		local e = Enc.new("Root", "beast:2", 1, 0, { x = 0, y = 0, z = -20 })
		local events = run(e, w, tgt, 0, 3)
		local tell = tellOf(events, "multi")
		local hits = hitsFor(events, tell.tell)
		equal(#hits, 1, "one hit per eruption")
		equal(hits[1].damage, T.TrapDamage)
		equal(hits[1].slow.multiplier, T.TrapSlowMultiplier); equal(hits[1].slow.seconds, T.TrapSlowSeconds)
		assert(hits[1].at >= tell.strikeAt - 1e-9 and hits[1].at <= tell.strikeAt + C.trapActiveSeconds + 1e-9, "inside the window")
		local recovery = find(events, "Phase", "phase", "Recovery")
		near(recovery.untilAt - recovery.at, C.attackCooldown)
	end)

	case("BW2 Root: a validated perfect dodge avoids the damage and the slow", function()
		local w = fakeWorld()
		w.verdict = "Dodged"
		local tgt = target(0, 0)
		local e = Enc.new("Root", "beast:3", 1, 0, { x = 0, y = 0, z = -20 })
		local events = run(e, w, tgt, 0, 3)
		equal(#hitsFor(events, tellOf(events, "multi").tell), 0)
		equal(find(events, "Strike").dodged, true)
	end)

	case("BW2 Root: lanes stop before a safe zone", function()
		local w = fakeWorld()
		function w.safe(_, z) return z > 1 end
		local tgt = target(0, 0)
		local e = Enc.new("Root", "beast:4", 1, 0, { x = 0, y = 0, z = -20 })
		local events = run(e, w, tgt, 0, 1.2)
		local tell = tellOf(events, "multi")
		for _, lane in ipairs(tell.shape.list) do
			local endZ = lane.oz + lane.dz * lane.length
			assert(not w.safe(lane.ox + lane.dx * lane.length, endZ), "a lane reaches a safe zone at z " .. endZ)
		end
	end)

	case("BW2 Root: the enclosure leaves one gap of at least 9 studs, away from Root; the whip cannot reach it", function()
		local w = fakeWorld()
		local tgt = target(0, 0)
		local e = Enc.new("Root", "beast:5", 1, 0, { x = 0, y = 0, z = -20 })
		local events = run(e, w, tgt, 0, 9)
		local walls = tellOf(events, "walls")
		assert(walls, "the walls tell")
		equal(walls.dodgeable, false, "walls never hit")
		near(walls.strikeAt - walls.startAt, C.wallTelegraph)
		local shape = walls.shape
		assert(Config.gapWidth(shape) >= T.SafeGapMinimumStuds - 1e-6, "gap " .. Config.gapWidth(shape))
		equal(Config.shapeHit(shape, shape.x, shape.z), false, "walls never deal damage")
		assert(shape.gz > 0.99, "the gap faces away from Root (which came from -z)")
		local burrow = find(events, "Move", "kind", "burrow")
		assert(burrow, "Root moves to the closed end")
		near(burrow.to.z, shape.z - shape.gz * C.enclosureRadius, "opposite the gap")
		local whip = tellOf(events, "sector")
		assert(whip and whip.dodgeable, "the whip tell, dodgeable")
		near(whip.strikeAt - whip.startAt, C.whipTelegraph)
		equal(whip.shape.arc, T.WhipArcDegrees)
		near(whip.startAt, walls.strikeAt + C.whipDelay, "the whip winds up during the hold")
		assert(whip.strikeAt <= walls.strikeAt + C.wallHold, "the whip strikes before the walls drop")
		-- Standing just outside the gap is out of the whip's reach; the centre is inside it.
		local outside = { x = shape.x + shape.gx * (shape.r + 1), z = shape.z + shape.gz * (shape.r + 1) }
		equal(Config.shapeHit(whip.shape, outside.x, outside.z), false, "the escape is safe")
		equal(Config.shapeHit(whip.shape, shape.x, shape.z), true, "staying inside is not")
	end)

	case("BW2 Root: leaving through the gap avoids the whip; staying is one hit", function()
		local w = fakeWorld()
		local tgt = target(0, 0)
		local e = Enc.new("Root", "beast:6", 1, 0, { x = 0, y = 0, z = -20 })
		local events = run(e, w, tgt, 0, 12)
		local whip = tellOf(events, "sector")
		equal(#hitsFor(events, whip.tell), 1, "stayed inside: one hit")
		equal(hitsFor(events, whip.tell)[1].damage, T.WhipDamage)
		local w2 = fakeWorld()
		local tgt2 = target(0, 0)
		local e2 = Enc.new("Root", "beast:7", 1, 0, { x = 0, y = 0, z = -20 })
		local events2 = run(e2, w2, tgt2, 0, 12, function(_, tg)
			if e2.walls and e2.phase ~= "TelegraphTrap" then tg.z = 11 end -- out through the gap
		end)
		local whip2 = tellOf(events2, "sector")
		equal(#hitsFor(events2, whip2.tell), 0, "escaped")
		local tellEnd = find(events2, "TellEnd")
		assert(tellEnd and tellEnd.tell:find(":walls", 1, true), "the walls go down")
	end)

	case("BW2 Root: with every gap blocked the enclosure is skipped and the trap is used instead", function()
		local w = fakeWorld()
		w.gapOpen = false
		local tgt = target(0, 0)
		local e = Enc.new("Root", "beast:8", 1, 0, { x = 0, y = 0, z = -20 })
		local events = run(e, w, tgt, 0, 9)
		equal(tellOf(events, "walls"), nil, "no enclosure without a way out")
		local traps = 0
		for _, ev in ipairs(events) do if ev.type == "Tell" and ev.shape.kind == "multi" then traps += 1 end end
		equal(traps, 2, "two traps")
	end)

	case("BIOME-OFF Root: out of the Pantano it keeps hunting (no home biome); a safe zone ends it at once", function()
		equal(Config.homeBiome("Root"), nil, "BIOME_PREFERENCE off")
		local w = fakeWorld()
		local tgt = target(0, 0)
		tgt.biomes = {}
		local e = Enc.new("Root", "beast:9", 1, 0, { x = 0, y = 0, z = -20 })
		local events = run(e, w, tgt, 0, 6)
		equal(find(events, "Disengage"), nil, "no LeftBiome outside the swamp")
		equal(find(events, "End"), nil, "still hunting after 6 s")
		assert(find(events, "Tell"), "it attacks in the open forest")
		local w2 = fakeWorld()
		local e2 = Enc.new("Root", "beast:10", 1, 0, { x = 0, y = 0, z = -20 })
		local safe = target(0, 0)
		safe.safe = true
		equal(find(Enc.step(e2, 0.05, safe, w2), "End").reason, "SafeZone")
	end)

	case("BR4 Root: every tell is faster than before but never under the 0.8 s floor; the enclosure stays escapable", function()
		assert(C.trapTelegraph < 1.15 and C.wallTelegraph < 1.25 and C.whipTelegraph < 0.85 and C.whipDelay < 1, "faster")
		assert(C.trapTelegraph >= Config.MIN_TELL and C.whipTelegraph >= Config.MIN_TELL and C.wallTelegraph >= Config.MIN_TELL,
			"readable tells")
		assert(C.attackCooldown < 3.5, "attacks come sooner")
		-- From the walls rising to the whip striking: time to walk out through the gap at a base 16 studs/s.
		assert(C.whipDelay + C.whipTelegraph >= (C.enclosureRadius + 1) / 16, "escapable at walking speed")
		assert(Config.gapWidth(Config.enclosure(0, 0, 0, 0, 1, C.enclosureRadius, T.SafeGapMinimumStuds)) >= 9 - 1e-6, "gap kept")
		equal(C.whipRange, 2 * C.enclosureRadius - 2, "the gap side stays out of the whip")
	end)

	case("BR4 Root: the roots reach farther (46): a target 40 studs away is covered by the lanes", function()
		assert(C.trapReach > T.DetectionRadiusStuds, "longer than the old 34")
		local w = fakeWorld()
		local tgt = target(0, 0)
		local e = Enc.new("Root", "beast:11", 1, 0, { x = 0, y = 0, z = -40 })
		local events = run(e, w, tgt, 0, 2)
		local tell = tellOf(events, "multi")
		assert(tell, "a trap at 40 studs")
		assert(Config.shapeHit(tell.shape, 0, 0), "the lanes reach the target")
		for _, lane in ipairs(tell.shape.list) do assert(lane.length <= C.trapReach + 1e-6, "capped at the reach") end
	end)

	case("BR4 Root: a target beyond its reach is followed underground, then attacked", function()
		local w = fakeWorld()
		local tgt = target(0, 0)
		local e = Enc.new("Root", "beast:12", 1, 0, { x = 0, y = 0, z = -90 })
		local events = run(e, w, tgt, 0, 4)
		local burrow = find(events, "Phase", "phase", "Burrow")
		assert(burrow, "it burrows closer")
		near(burrow.untilAt - burrow.at, C.burrowSeconds)
		local move = find(events, "Move", "kind", "burrow")
		near(Config.flat(move.to.x, move.to.z, 0, 0), C.burrowTo, "it rises burrowTo studs away", 1e-6)
		assert(tellOf(events, "multi") or tellOf(events, "walls"), "then attacks")
	end)

	case("BW2 Root: the module is pure and server-only", function()
		for _, banned in ipairs({ "workspace", "game:", "task.", "os.clock", "math.random", "Random.new", "Touched", "FireClient" }) do
			assert(not source:find(banned, 1, true), "source uses " .. banned)
		end
	end)

	return result
end]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX4"><Properties><string name="Name">WildboundBeastLurker_Test</string><ProtectedString name="Source"><![CDATA[-- Invoke with require(freshTestClone)(require(freshBeastEncountersClone), require(freshBeastLurkerClone),
-- require(freshBeastConfigClone), freshBeastLurkerClone.Source).
-- Wave 2 (odd/tasks/wildbound-beasts-wave2.md, BW2-5): Lurker's state machine, pure. target.observe stands in for the
-- validated observation; a fake world (flat ground at y 0, every landing valid, open lines) and a fake dodge.
return function(Enc, Lurker, Config, source)
	local result = { passed = 0, failed = 0, messages = {} }
	local function case(name, run)
		local ok, message = pcall(run)
		if ok then result.passed += 1 else
			result.failed += 1
			table.insert(result.messages, name .. ": " .. tostring(message))
		end
	end
	local function equal(actual, expected, label)
		assert(actual == expected, (label and label .. ": " or "") .. "expected " .. tostring(expected) .. ", got " .. tostring(actual))
	end
	local function near(actual, expected, label, tolerance)
		assert(type(actual) == "number" and math.abs(actual - expected) <= (tolerance or 1e-6),
			(label and label .. ": " or "") .. "expected " .. tostring(expected) .. ", got " .. tostring(actual))
	end
	Enc.register("Lurker", Lurker)
	local C = Config.BEASTS.Lurker
	local T = C.tuning
	local LEAP_TELL = 0.8 -- the pack's LeapTelegraphSeconds before the revision (BR6 keeps it)

	local function fakeWorld()
		local w = { telegraphs = {}, resolved = {}, cancelled = {}, verdict = "Hit" }
		function w.ground() return 0 end
		function w.landing() return 0 end
		function w.lineOfSight() return true end
		function w.telegraph(id, beast, startAt, strikeAt)
			table.insert(w.telegraphs, { id = id, beast = beast, startAt = startAt, strikeAt = strikeAt })
			return true
		end
		function w.resolve(id) table.insert(w.resolved, id); return w.verdict end
		function w.cancel(id) table.insert(w.cancelled, id) end
		return w
	end
	local function target(looking)
		local tgt = { x = 0, y = 3, z = 0, alive = true, safe = false, biomes = {}, calls = {}, now = 0 }
		tgt.observe = function(point, halfAngle, maxDist, favour)
			table.insert(tgt.calls, { halfAngle = halfAngle, maxDist = maxDist, favour = favour })
			return looking(tgt.now)
		end
		return tgt
	end
	local function run(e, w, tgt, from, to, move)
		local all = {}
		for i = 0, math.floor((to - from) / 0.05 + 1e-6) do
			local t = from + i * 0.05
			tgt.now = t
			if move then move(t, tgt) end
			for _, ev in ipairs(Enc.step(e, t, tgt, w)) do table.insert(all, ev) end
		end
		return all
	end
	local function find(events, kind, field, value)
		for _, ev in ipairs(events) do
			if ev.type == kind and (field == nil or ev[field] == value) then return ev end
		end
		return nil
	end
	local function always(value) return function() return value end end
	local function flat(e, tgt) return Config.flat(e.pos.x, e.pos.z, tgt.x, tgt.z) end

	case("BW2 Lurker: presence is clues only: no leap even in range; the observation favours the player", function()
		local w = fakeWorld()
		local tgt = target(always(false))
		local e = Enc.new("Lurker", "beast:1", 1, 0, { x = 0, y = 0, z = -15 }) -- already in leap range
		local events = run(e, w, tgt, 0, C.presenceSeconds - 0.05)
		equal(find(events, "Tell"), nil, "no leap while present")
		near(flat(e, tgt), 15, "it keeps its distance")
		equal(tgt.calls[1].favour, true, "a short gap in the camera data reads as observed")
		equal(tgt.calls[1].halfAngle, C.observeCone)
	end)

	case("BW2 Lurker: unobserved it closes in by walking bursts, then a 0.8 s windup and a 0.55 s leap; one hit", function()
		local w = fakeWorld()
		local tgt = target(always(false))
		local e = Enc.new("Lurker", "beast:2", 1, 0, { x = 0, y = 0, z = -T.InitialSpawnDistanceStuds })
		local maxStep = 0
		local last, lastPhase = { x = e.pos.x, z = e.pos.z }, e.phase
		local events = run(e, w, tgt, 0, 9, function()
			-- Only steps that began and ended outside the leap: stalking never jumps.
			local stalking = { Presence = true, CoverApproach = true, StalkObserved = true }
			if stalking[lastPhase] and stalking[e.phase] then
				maxStep = math.max(maxStep, Config.flat(last.x, last.z, e.pos.x, e.pos.z))
			end
			last, lastPhase = { x = e.pos.x, z = e.pos.z }, e.phase
		end)
		assert(maxStep <= T.UnobservedApproachSpeedStudsPerSecond * 0.05 + 1e-6, "never a jump while stalking: " .. maxStep)
		local tell = find(events, "Tell")
		assert(tell and tell.shape.kind == "circle", "the landing circle")
		equal(tell.shape.r, C.leapRadius)
		near(tell.strikeAt - tell.startAt, T.LeapTelegraphSeconds + T.LeapTravelSeconds)
		near(tell.lockAt - tell.startAt, T.LeapTelegraphSeconds, "the spot freezes at the end of the windup")
		local reg = w.telegraphs[1]
		equal(reg.id, tell.tell); equal(reg.beast, "Lurker")
		local hits = 0
		for _, ev in ipairs(events) do if ev.type == "Hit" then hits += 1; equal(ev.damage, T.LeapDamage) end end
		equal(hits, 1, "one hit per leap")
		local arc = find(events, "Move", "kind", "arc")
		assert(arc, "the arc for the client")
		near(arc.landAt - arc.at, T.LeapTravelSeconds)
	end)

	case("BW2 Lurker: observed it freezes 1.4 s, then backs off; it never leaps while watched", function()
		local w = fakeWorld()
		local tgt = target(always(true))
		local e = Enc.new("Lurker", "beast:3", 1, 0, { x = 0, y = 0, z = -30 })
		run(e, w, tgt, 0, C.presenceSeconds)
		local d0 = flat(e, tgt)
		local events = run(e, w, tgt, C.presenceSeconds + 0.05, C.presenceSeconds + T.ObservedPauseSeconds - 0.05)
		equal(e.phase, "StalkObserved")
		near(flat(e, tgt), d0, "frozen during the pause")
		events = run(e, w, tgt, C.presenceSeconds + T.ObservedPauseSeconds + 0.05, 12)
		assert(flat(e, tgt) > d0 + 1, "it backs off while watched")
		equal(find(events, "Tell"), nil, "no leap while watched")
	end)

	case("BW2 Lurker: hysteresis: a flickering observation never flips its state", function()
		local w = fakeWorld()
		local flip = false
		local tgt = target(function() flip = not flip; return flip end)
		local e = Enc.new("Lurker", "beast:4", 1, 0, { x = 0, y = 0, z = -40 })
		local events = run(e, w, tgt, 0, 6)
		equal(find(events, "Phase", "phase", "StalkObserved"), nil)
		assert(find(events, "Phase", "phase", "CoverApproach"), "it keeps approaching")
	end)

	case("BW2 Lurker: a validated perfect dodge: no damage, an overrun of 7 studs and a 1.8 s stun", function()
		local w = fakeWorld()
		w.verdict = "Dodged"
		local tgt = target(always(false))
		local e = Enc.new("Lurker", "beast:5", 1, 0, { x = 0, y = 0, z = -T.InitialSpawnDistanceStuds })
		local events = run(e, w, tgt, 0, 9)
		equal(find(events, "Hit"), nil)
		local slide = find(events, "Move", "kind", "slide")
		assert(slide, "the overrun")
		near(Config.flat(slide.from.x, slide.from.z, slide.to.x, slide.to.z), T.LeapOverrunDistanceStuds)
		assert(slide.to.z > slide.from.z, "past the spot, along the leap")
		local stun = find(events, "Phase", "phase", "OverrunStunned")
		near(stun.untilAt - stun.at, T.PerfectDodgeStunSeconds)
	end)

	case("BW2 Lurker: a target that teleports during the windup calls the leap off; a safe zone ends it", function()
		local w = fakeWorld()
		local tgt = target(always(false))
		local e = Enc.new("Lurker", "beast:6", 1, 0, { x = 0, y = 0, z = -T.InitialSpawnDistanceStuds })
		local events = run(e, w, tgt, 0, 9, function(_, tg) if e.phase == "LeapWindup" then tg.x = 90 end end)
		local dropped = find(events, "TellEnd")
		assert(dropped and dropped.reason == "NoLanding", "no leap at a far spot")
		equal(w.cancelled[1], w.telegraphs[1].id, "the dodge registration is cancelled")
		equal(find(events, "Hit"), nil)
		local w2 = fakeWorld()
		local tgt2 = target(always(false))
		local e2 = Enc.new("Lurker", "beast:7", 1, 0, { x = 0, y = 0, z = -T.InitialSpawnDistanceStuds })
		local ended
		run(e2, w2, tgt2, 0, 9, function(_, tg)
			if e2.phase == "LeapWindup" and not ended then
				tg.safe = true
				ended = true
				assert(next(e2.open) ~= nil, "the leap is open when the target reaches safety")
			end
		end)
		equal(e2.endReason, "SafeZone")
	end)

	case("BR6 Lurker: the leap's landing circle is hidden (never drawn) but the mechanic and the dodge are unchanged", function()
		equal(C.hideTells, true)
		local w = fakeWorld()
		local tgt = target(always(false))
		local e = Enc.new("Lurker", "beast:9", 1, 0, { x = 0, y = 0, z = -T.InitialSpawnDistanceStuds })
		local events = run(e, w, tgt, 0, 9)
		local tells = 0
		for _, ev in ipairs(events) do
			if ev.type == "Tell" then tells += 1; equal(ev.hidden, true, "every leap tell is hidden") end
		end
		assert(tells >= 1, "the leap still exists")
		assert(find(events, "Hit"), "it still lands")
		equal(w.telegraphs[1].beast, "Lurker", "still a perfect-dodge registration")
		near(LEAP_TELL, T.LeapTelegraphSeconds, "same windup timing")
	end)

	case("BW2 Lurker: the module is pure and server-only", function()
		for _, banned in ipairs({ "workspace", "game:", "task.", "os.clock", "math.random", "Random.new", "Touched", "FireClient" }) do
			assert(not source:find(banned, 1, true), "source uses " .. banned)
		end
	end)

	return result
end]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX5"><Properties><string name="Name">WildboundBeastStreamer</string><ProtectedString name="Source"><![CDATA[-- Beast revision BR3 (odd/tasks/wildbound-beast-revision.md, owner 2026-11-16): the Screamer (internal id "Streamer",
-- kept so the director, the config, the rig data and the saved place keep working; players only ever read "Screamer",
-- WildboundText). Server only and pure, stepped by WildboundBeastEncounters through Enc.register. State machine:
--   Spawn -> Statue (A: it never moves and never attacks; the client draws it in stone) until the target comes within
--   activationDistance -> Scream (B: screamSeconds of a harmless scream: no damage, no push, no tell; the client reveals
--   the true form) -> Pursue (C: chaseSpeed, very fast; the persistent chase of WildboundBeastChase applies from here)
--   -> CatchTell (within catchRange: a catchTell-long grab circle on the target, following it until catchLockLead before
--   the strike, then fixed; registered with the perfect dodge) -> Recovery (catchRecover) -> Pursue ...
-- Teleport repositioning, only in Pursue: when the target is farther than teleportFar, or out of its line of sight for
-- teleportUnseenSeconds, and the cooldown is over, it asks world.nearSpot for a point teleportMin..teleportMax from the
-- target and accepts it only through WildboundBeastChase.validSpot (grounded, out of every safe zone, never within
-- teleportClearance of the target). A refused point cancels that try (a short retry) and the chase goes on; after a jump
-- the grab waits teleportGrabBlock, so a teleport can never land a hit by itself. It never changes the target.
-- An unwoken statue ends quietly after statueSeconds ("Unwoken"): the chase rule starts at the scream.
-- Every number is Config.BEASTS.Streamer (the BR3 fields; the pack's `tuning` table stays for reference only).
local DataModel = script:FindFirstAncestorOfClass("DataModel") :: any
local Config = require(DataModel:GetService("ReplicatedStorage"):WaitForChild("WildboundBeastConfig"))
local Chase = require(DataModel:GetService("ReplicatedStorage"):WaitForChild("WildboundBeastChase"))
local Attack = require(DataModel:GetService("ServerScriptService"):WaitForChild("WildboundBeastAttack"))
local Streamer = {}

local copy, emit = Attack.copy, Attack.emit

function Streamer.init(e)
	e.catchReadyAt, e.teleportReadyAt, e.unseenSince, e.teleports, e.teleportRefused = -math.huge, -math.huge, nil, 0, 0
end

local function lineOfSight(world, e, target)
	if not world.lineOfSight then return true end
	return world.lineOfSight(e.pos, target) == true
end

-- One teleport try. Returns true when it moved.
function Streamer.teleport(events, e, now, target, world, C)
	local spot = world.nearSpot and world.nearSpot(target, C.teleportMin, C.teleportMax) or nil
	local ok, why = Chase.validSpot(spot, target, { min = C.teleportMin, max = C.teleportMax,
		clearance = C.teleportClearance, safe = world.safe })
	if not ok then
		e.teleportRefused += 1
		e.teleportReadyAt = now + C.teleportRetry
		emit(events, e, "TeleportRefused", now, { reason = why })
		return false
	end
	emit(events, e, "Move", now, { kind = "blink", from = copy(e.pos), to = copy(spot) })
	e.pos.x, e.pos.y, e.pos.z = spot.x, spot.y, spot.z
	Attack.face(e, target)
	e.teleports += 1
	e.teleportReadyAt = now + C.teleportCooldown
	e.catchReadyAt = math.max(e.catchReadyAt, now + C.teleportGrabBlock)
	e.unseenSince = nil
	return true
end

local function startCatch(events, e, now, target, world, C)
	local strikeAt = now + C.catchTell
	local attack = Attack.open(events, e, world, { key = "catch", startAt = now, strikeAt = strikeAt, dodgeable = true,
		damage = C.catchDamage, shape = { kind = "circle", x = target.x, y = Attack.groundAt(world, target.x, target.z, target.y - 3),
			z = target.z, r = C.catchRadius } })
	if not attack then return false end
	e.catch = attack
	Attack.face(e, target)
	Attack.phase(events, e, "CatchTell", now, strikeAt)
	return true
end

function Streamer.step(events, e, now, target, world, dt)
	local C = Config.BEASTS.Streamer
	if Attack.guard(events, e, now, target, { busy = e.phase == "CatchTell", disengage = C.disengage }) then return end

	if e.phase == "Spawn" then
		Attack.phase(events, e, "Statue", e.phaseAt)
	end
	if e.phase == "Statue" then
		-- A: still as stone. Only the distance wakes it.
		if Attack.distance(e, target) <= C.activationDistance then
			Attack.face(e, target)
			Attack.phase(events, e, "Scream", now, now + C.screamSeconds)
		elseif now - e.phaseAt >= C.statueSeconds then
			Attack.disengage(events, e, "Unwoken", now, C.disengage)
		end
		return
	end
	if e.phase == "Scream" then
		-- B: the scream is the transformation, never an attack.
		Attack.face(e, target)
		if now - e.phaseAt >= C.screamSeconds then Attack.phase(events, e, "Pursue", e.phaseAt + C.screamSeconds) end
	end
	if e.phase == "Pursue" then
		local distance = Attack.distance(e, target)
		local seen = lineOfSight(world, e, target)
		if seen then e.unseenSince = nil else e.unseenSince = e.unseenSince or now end
		local lost = distance > C.teleportFar or (e.unseenSince ~= nil and now - e.unseenSince >= C.teleportUnseenSeconds)
		if lost and now >= e.teleportReadyAt and Streamer.teleport(events, e, now, target, world, C) then
			return
		end
		if distance <= C.catchRange and now >= e.catchReadyAt then
			if not startCatch(events, e, now, target, world, C) then Attack.face(e, target) end
		elseif distance > C.catchRange * 0.8 then
			Attack.walk(e, target, C.chaseSpeed, 1, dt, world)
		else
			Attack.face(e, target)
		end
	end
	if e.phase == "CatchTell" and now < e.catch.strikeAt then
		-- The grab circle follows the target until catchLockLead before the strike, then never moves; it keeps running
		-- behind the target meanwhile (a perfect dodge or a sidestep after the lock escapes it).
		local attack = e.catch
		Attack.walk(e, target, C.chaseSpeed, 1, dt, world)
		if now < attack.strikeAt - C.catchLockLead then
			Attack.aim(events, e, attack, { kind = "circle", x = target.x,
				y = Attack.groundAt(world, target.x, target.z, target.y - 3), z = target.z, r = C.catchRadius }, now)
		elseif not attack.lockedNow then
			attack.lockedNow = true
			Attack.lock(events, e, attack, nil, attack.strikeAt - C.catchLockLead)
		end
	end
	if e.phase == "CatchTell" and now >= e.catch.strikeAt then
		local attack = e.catch
		if Attack.inside(attack.shape, target, attack.shape.y, C.hitHeight) then
			Attack.hit(events, e, world, attack, attack.strikeAt)
		else
			Attack.miss(events, e, world, attack, attack.strikeAt)
		end
		e.catch = nil
		e.catchReadyAt = attack.strikeAt + C.catchCooldown
		e.recoverUntil = attack.strikeAt + C.catchRecover
		Attack.phase(events, e, "Recovery", attack.strikeAt, e.recoverUntil)
	end
	if e.phase == "Recovery" and now >= e.recoverUntil then
		Attack.phase(events, e, "Pursue", e.recoverUntil)
	end
end

return Streamer]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX6"><Properties><string name="Name">WildboundBeastGaze</string><ProtectedString name="Source"><![CDATA[-- Beast revision BR5 (odd/tasks/wildbound-beast-revision.md, owner 2026-11-16): Gaze, the big black watcher. Server
-- only and pure, stepped by WildboundBeastEncounters through Enc.register. State machine:
--   Spawn -> Manifest (manifestSeconds: it can be found, nothing counts yet) -> Watch / ExposureBuild:
--   while the target really looks at it (target.observe: the validated camera direction inside SightConeDegrees and
--   MaxViewDistanceStuds, AND the server's own raycast line of sight, so walls and opaque cover block it; favour false,
--   so lag never counts) the exposure grows by dt; looking away PAUSES it (it never decays, never resets) and the phase
--   goes back to Watch. Exposure events (0..1, `paused`) drive the client's progressive warning.
--   At killSeconds of ACCUMULATED exposure: one Hit with killDamage (100, the BeastHit maximum; MaxHealth is 100) and
--   `kill`, exactly once per encounter (e.killed). The defeat goes through the game's one strike path (WildboundServer
--   BeastHit): health only drops where damage is allowed (the private test place and a lethal player); elsewhere it
--   knocks the carried egg out. A spent Gaze keeps watching and never strikes again in that encounter.
-- Persistent chase (WildboundBeastChase): no Unseen or Timeout exit; out of view range and unobserved it reappears
-- within range (world.reposition, never in a safe zone) at most every repositionSeconds. The exposure lives on the
-- encounter, so it starts at 0 in every new encounter (death, a safe zone and a respawn all end the encounter).
-- Every number is Config.BEASTS.Gaze (the BR5 fields; the pack's zone attack in `tuning` is no longer used).
local DataModel = script:FindFirstAncestorOfClass("DataModel") :: any
local Config = require(DataModel:GetService("ReplicatedStorage"):WaitForChild("WildboundBeastConfig"))
local Attack = require(DataModel:GetService("ServerScriptService"):WaitForChild("WildboundBeastAttack"))
local Gaze = {}

local finite = Config.finite
local copy, emit = Attack.copy, Attack.emit
Gaze.EXPOSURE_RATE = 0.1 -- the exposure meter is sent at most this often while it changes

function Gaze.init(e, now)
	e.exposure, e.exposureSentAt, e.sentExposure, e.sentPaused = 0, -math.huge, -1, nil
	e.killed, e.nextReposition = false, -math.huge
end

local function observed(e, target, T)
	if type(target.observe) ~= "function" then return false end
	local eyes = { x = e.pos.x, y = e.pos.y + Config.BEASTS.Gaze.eyeHeight, z = e.pos.z }
	return target.observe(eyes, T.SightConeDegrees, T.MaxViewDistanceStuds, false) == true
end

local function sendExposure(events, e, now, C, paused, force)
	local value = math.clamp(e.exposure / C.killSeconds, 0, 1)
	local changed = math.abs(value - e.sentExposure) > 0.02 and now - e.exposureSentAt >= Gaze.EXPOSURE_RATE
	if force or changed or paused ~= e.sentPaused then
		e.sentExposure, e.exposureSentAt, e.sentPaused = value, now, paused
		emit(events, e, "Exposure", now, { value = value, paused = paused })
	end
end

-- Exposure for this step: accumulates while seen, holds otherwise. Returns the new total.
function Gaze.expose(e, dt, seen)
	if seen and not e.killed then e.exposure += dt end
	return e.exposure
end

function Gaze.step(events, e, now, target, world, dt)
	local C = Config.BEASTS.Gaze
	local T = C.tuning
	if Attack.guard(events, e, now, target, { disengage = C.disengage }) then return end

	if e.phase == "Spawn" then
		Attack.phase(events, e, "Manifest", e.phaseAt, e.phaseAt + C.manifestSeconds)
	end
	if e.phase == "Manifest" then
		Attack.face(e, target)
		if now - e.phaseAt >= C.manifestSeconds then Attack.phase(events, e, "Watch", e.phaseAt + C.manifestSeconds) end
		return
	end
	Attack.face(e, target)
	local seen = not e.killed and observed(e, target, T)
	Gaze.expose(e, dt, seen)
	if seen and e.phase == "Watch" then
		Attack.phase(events, e, "ExposureBuild", now)
	elseif not seen and e.phase == "ExposureBuild" then
		emit(events, e, "SightBreak", now) -- the count pauses (never resets)
		Attack.phase(events, e, "Watch", now)
	end
	if not e.killed and e.exposure >= C.killSeconds - 1e-9 then
		e.killed, e.exposure = true, C.killSeconds
		sendExposure(events, e, now, C, false, true)
		Attack.phase(events, e, "Kill", now)
		emit(events, e, "Hit", now, { damage = C.killDamage, attack = e.id .. ":gaze", kill = true })
		return -- spent: it stays in Kill (watching, never striking again) for the rest of the encounter
	end
	if not e.killed then sendExposure(events, e, now, C, not seen, false) end
	if not seen and Attack.distance(e, target) > T.MaxViewDistanceStuds and now >= e.nextReposition then
		-- Persistent: out of view range and unobserved, it reappears within range behind other cover.
		e.nextReposition = now + C.repositionSeconds
		local spot = world.reposition and world.reposition(e, target)
		if spot then
			emit(events, e, "Move", now, { kind = "blink", from = copy(e.pos), to = copy(spot) })
			e.pos.x, e.pos.y, e.pos.z = spot.x, spot.y, spot.z
		end
	end
	if not finite(e.exposure) then e.exposure = 0 end
end

return Gaze]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX7"><Properties><string name="Name">WildboundBeastRoot</string><ProtectedString name="Source"><![CDATA[-- Wave 2 (odd/tasks/wildbound-beasts-wave2.md, BW2-5): Root, the swamp's root beast (pack 02_BESTIAS/ROOT). Server
-- only and pure, stepped by WildboundBeastEncounters through Enc.register. With Config.BIOME_PREFERENCE on it is rolled
-- only with the Swamp tag (director) and gives up when the target stays out of the Pantano; with it off (now) it is a
-- global beast and hunts anywhere. Nothing here needs swamp terrain: the rise, lanes and walls use world.ground and
-- world.landing, which are plain ground raycasts. State machine (pack names):
--   Rise (out of the mud, no tell yet) -> SelectAttack, alternating:
--   a) TelegraphTrap (Fase 1, TrapTelegraphSeconds: cracks mark the exact lanes, fixed by the server, never following
--      the target, cut before any safe zone) -> Erupt (Fase 2, an active window of trapActiveSeconds: one hit per
--      eruption, TrapDamage and a slow; a validated perfect dodge avoids both)
--   b) TelegraphWalls (Fase 3, WallTelegraphSeconds: two walls around the target with ONE gap of at least
--      SafeGapMinimumStuds facing away from Root; a blocked gap is turned, and with no clear gap the enclosure is
--      skipped) -> WallHold (WallHoldSeconds; walls block, never damage) -> WhipWindup (Fase 4, WhipTelegraphSeconds,
--      from Root at the walls' closed end, so the gap side is out of its reach) -> WhipActive (one sweep of the drawn
--      sector, WhipDamage)
--   -> Recovery (AttackCooldownSeconds) -> SelectAttack ... -> Disengage (out of the Pantano, too far, timeout) -> End.
-- Every number is Config.BEASTS.Root (tuning = PROPUESTA DE BALANCE).
local DataModel = script:FindFirstAncestorOfClass("DataModel") :: any
local Config = require(DataModel:GetService("ReplicatedStorage"):WaitForChild("WildboundBeastConfig"))
local Attack = require(DataModel:GetService("ServerScriptService"):WaitForChild("WildboundBeastAttack"))
local Chase = require(DataModel:GetService("ReplicatedStorage"):WaitForChild("WildboundBeastChase")) -- BR0
local Root = {}

local finite, unit = Config.finite, Config.unit
local copy, emit = Attack.copy, Attack.emit

function Root.init(e)
	e.nextAttack = "trap"
	e.outSince = nil
end

local function safeAt(world, x, z)
	return world.safe ~= nil and world.safe(x, z) == true
end

-- Cuts a lane before the first point (every 2 studs) that lies in a safe zone. nil when nothing is left.
function Root.trimLane(lane, world)
	local step = 2
	local length = lane.length
	for d = 0, lane.length, step do
		if safeAt(world, lane.ox + lane.dx * d, lane.oz + lane.dz * d) then
			length = d - step
			break
		end
	end
	if length < lane.width then return nil end
	lane.length = length
	return lane
end

-- The gap direction: away from Root through the target, turned by 60 degree steps when world.gapClear says the way out
-- is blocked. nil when every direction is blocked (the pack: cancel the enclosure).
function Root.gapFor(e, center, world, C)
	local gx, gz = unit(center.x - e.pos.x, center.z - e.pos.z)
	if not gx then gx, gz = e.dx, e.dz end
	for _, turn in ipairs({ 0, 60, -60, 120, -120, 180 }) do
		local a = math.rad(turn)
		local x, z = gx * math.cos(a) - gz * math.sin(a), gx * math.sin(a) + gz * math.cos(a)
		if not world.gapClear or world.gapClear(center, x, z, C.enclosureRadius) then return x, z end
	end
	return nil
end

local function startTrap(events, e, now, target, world, C, T)
	-- BR4: the roots reach trapReach (was DetectionRadiusStuds 34).
	local shape = Config.rootLanes(e.pos.x, e.pos.y, e.pos.z, target.x, target.z, C.trapLanes, C.trapSpread,
		T.TrapLaneWidthStuds, C.trapReach)
	if not shape then return false end
	local kept = {}
	for _, lane in ipairs(shape.list) do
		local trimmed = Root.trimLane(lane, world)
		if trimmed then table.insert(kept, trimmed) end
	end
	if #kept == 0 then return false end
	shape.list = kept
	shape.segments = C.trapSegments
	local strikeAt = now + C.trapTelegraph
	local attack = Attack.open(events, e, world, { key = "trap", startAt = now, strikeAt = strikeAt, dodgeable = true,
		damage = T.TrapDamage, shape = shape })
	if not attack then return false end
	attack.locked = true -- fixed by the server from the first frame: the lanes never follow the target
	e.trap = attack
	Attack.phase(events, e, "TelegraphTrap", now, strikeAt)
	return true
end

local function startWalls(events, e, now, target, world, C, T)
	local center = { x = target.x, y = Attack.groundAt(world, target.x, target.z, e.pos.y), z = target.z }
	local gx, gz = Root.gapFor(e, center, world, C)
	if not gx then return false end
	-- Root stands at the closed end, opposite the gap, on valid ground.
	local bx, bz = center.x - gx * C.enclosureRadius, center.z - gz * C.enclosureRadius
	local by = center.y
	if world.landing then by = world.landing(bx, bz, center.y) end
	if not finite(by) then return false end
	local walls = Config.enclosure(center.x, center.y, center.z, gx, gz, C.enclosureRadius, T.SafeGapMinimumStuds)
	if not walls then return false end
	local upAt = now + C.wallTelegraph
	e.walls = { shape = walls, upAt = upAt, downAt = upAt + C.wallHold, up = false }
	-- The walls never hit: they are a tell (and, on the target's client, a barrier), not an attack.
	emit(events, e, "Tell", now, { tell = e.id .. ":walls", shape = walls, startAt = now, strikeAt = upAt,
		dodgeable = false, locked = true })
	emit(events, e, "Move", now, { kind = "burrow", from = copy(e.pos), to = { x = bx, y = by, z = bz },
		untilAt = now + math.min(1, C.wallTelegraph) })
	e.pos.x, e.pos.y, e.pos.z = bx, by, bz
	e.dx, e.dz = gx, gz
	Attack.phase(events, e, "TelegraphWalls", now, upAt)
	return true
end

local function startWhip(events, e, now, world, C, T)
	local w = e.walls.shape
	local dx, dz = unit(w.x - e.pos.x, w.z - e.pos.z)
	if not dx then dx, dz = e.dx, e.dz end
	local strikeAt = now + C.whipTelegraph
	local attack = Attack.open(events, e, world, { key = "whip", startAt = now, strikeAt = strikeAt, dodgeable = true,
		damage = T.WhipDamage, shape = { kind = "sector", x = e.pos.x, y = e.pos.y, z = e.pos.z, dx = dx, dz = dz,
			r = C.whipRange, arc = T.WhipArcDegrees } })
	if not attack then return false end
	attack.locked = true -- "bloquea orientación horizontal antes de barrer": fixed at the windup's start
	e.whip = attack
	Attack.phase(events, e, "WhipWindup", now, strikeAt)
	return true
end

local function recover(events, e, at, T)
	e.recoverUntil = at + Config.BEASTS.Root.attackCooldown
	Attack.phase(events, e, "Recovery", at, e.recoverUntil)
end

-- BR4: a target beyond burrowReach is followed underground: Root sinks and rises burrowTo studs from it (toward its
-- old spot, on valid ground), then attacks. With no valid ground there it walks (the shared catch-up speed applies).
local function burrowCloser(events, e, now, target, world, C)
	local dx, dz = unit(e.pos.x - target.x, e.pos.z - target.z)
	if not dx then return false end
	local bx, bz = target.x + dx * C.burrowTo, target.z + dz * C.burrowTo
	local by = world.landing and world.landing(bx, bz, e.pos.y) or Attack.groundAt(world, bx, bz, e.pos.y)
	if not finite(by) then return false end
	emit(events, e, "Move", now, { kind = "burrow", from = copy(e.pos), to = { x = bx, y = by, z = bz },
		untilAt = now + C.burrowSeconds })
	e.pos.x, e.pos.y, e.pos.z = bx, by, bz
	Attack.face(e, target)
	Attack.phase(events, e, "Burrow", now, now + C.burrowSeconds)
	return true
end

function Root.step(events, e, now, target, world, dt)
	local C = Config.BEASTS.Root
	local T = C.tuning
	local busy = e.phase == "TelegraphTrap" or e.phase == "Erupt" or e.phase == "WhipWindup"
	if Attack.guard(events, e, now, target, { timeout = T.EncounterTimeoutSeconds, escapeDistance = T.DetectionRadiusStuds,
		escapeSeconds = C.escapeSeconds, busy = busy, disengage = C.disengage }) then return end
	-- Out of its home biome (the Pantano, only while Config.BIOME_PREFERENCE is on) for escapeSeconds: it gives up.
	-- BR0: the persistent chase overrides the biome exit (only death or a safe zone ends it).
	local home = not Chase.persistent(e.beast) and Config.homeBiome("Root") or nil
	if home and type(target.biomes) == "table" and target.biomes[home] ~= true then
		e.outSince = e.outSince or now
		if not busy and now - e.outSince >= C.escapeSeconds then
			Attack.disengage(events, e, "LeftBiome", now, C.disengage)
			return
		end
	else
		e.outSince = nil
	end

	if e.phase == "Spawn" then
		Attack.phase(events, e, "Rise", e.phaseAt, e.phaseAt + C.spawnSeconds)
	end
	if e.phase == "Rise" and now - e.phaseAt >= C.spawnSeconds then
		Attack.phase(events, e, "SelectAttack", e.phaseAt + C.spawnSeconds)
	end
	if e.phase == "Burrow" and now - e.phaseAt >= C.burrowSeconds then
		Attack.phase(events, e, "SelectAttack", e.phaseAt + C.burrowSeconds)
	end
	if e.phase == "SelectAttack" and Attack.distance(e, target) > C.burrowReach then
		if not burrowCloser(events, e, now, target, world, C) then Attack.walk(e, target, 10, 1, dt, world) end
	end
	if e.phase == "SelectAttack" then
		Attack.face(e, target)
		local started = false
		if e.nextAttack == "walls" then
			started = startWalls(events, e, now, target, world, C, T)
			if started then e.nextAttack = "trap" end
		end
		if not started then
			started = startTrap(events, e, now, target, world, C, T)
			if started then e.nextAttack = "walls" end
		end
	end
	if e.phase == "TelegraphTrap" and now >= e.trap.strikeAt then
		Attack.phase(events, e, "Erupt", e.trap.strikeAt, e.trap.strikeAt + C.trapActiveSeconds)
	end
	if e.phase == "Erupt" then
		local attack = e.trap
		local closeAt = attack.strikeAt + C.trapActiveSeconds
		if not attack.done and now <= closeAt + 1e-9 and Attack.inside(attack.shape, target, e.pos.y, C.hitHeight) then
			Attack.hit(events, e, world, attack, now, { slow = { multiplier = T.TrapSlowMultiplier,
				seconds = T.TrapSlowSeconds } })
		end
		if now >= closeAt then
			if not attack.done then Attack.miss(events, e, world, attack, closeAt) end
			e.trap = nil
			recover(events, e, closeAt, T)
		end
	end
	if e.phase == "TelegraphWalls" and now >= e.walls.upAt then
		e.walls.up = true
		Attack.phase(events, e, "WallHold", e.walls.upAt, e.walls.downAt)
	end
	if e.phase == "WallHold" and now - e.phaseAt >= C.whipDelay then
		-- The first try starts on the planned instant; a staggered retry starts now. A whip that could no longer strike
		-- before the walls drop is skipped (never a strike after the enclosure is gone).
		local startAt = math.max(now - 0.05, e.phaseAt + C.whipDelay)
		local fits = startAt + C.whipTelegraph <= e.walls.downAt
		if not (fits and startWhip(events, e, startAt, world, C, T)) and (not fits or now >= e.walls.downAt) then
			emit(events, e, "TellEnd", now, { tell = e.id .. ":walls" })
			e.walls = nil
			recover(events, e, now, T)
		end
	end
	if e.phase == "WhipWindup" and now >= e.whip.strikeAt then
		local attack = e.whip
		if Attack.inside(attack.shape, target, attack.shape.y, C.hitHeight) then
			Attack.hit(events, e, world, attack, attack.strikeAt)
		else
			Attack.miss(events, e, world, attack, attack.strikeAt)
		end
		e.whip = nil
		Attack.phase(events, e, "WhipActive", attack.strikeAt, e.walls and e.walls.downAt or attack.strikeAt)
	end
	if e.phase == "WhipActive" and (not e.walls or now >= e.walls.downAt) then
		local at = e.walls and e.walls.downAt or now
		if e.walls then emit(events, e, "TellEnd", at, { tell = e.id .. ":walls" }) end
		e.walls = nil
		recover(events, e, at, T)
	end
	if e.phase == "Recovery" and now >= e.recoverUntil then
		Attack.phase(events, e, "SelectAttack", e.recoverUntil)
	end
end

return Root]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX8"><Properties><string name="Name">WildboundBeastLurker</string><ProtectedString name="Source"><![CDATA[-- Wave 2 (odd/tasks/wildbound-beasts-wave2.md, BW2-5): Lurker, the stalker that moves while unseen (pack
-- 02_BESTIAS/LURKER). Server only and pure, stepped by WildboundBeastEncounters through Enc.register. State machine:
--   SilentSpawn (behind the target, InitialSpawnDistanceStuds, out of view when possible) -> Presence (Fase 1:
--   presenceSeconds of clues only, never a leap) -> Stalk (Fase 2: observed -> StalkObserved: it freezes for
--   ObservedPauseSeconds, then backs off at ObservedRetreatSpeed while still observed; unobserved -> CoverApproach,
--   Fase 3: it closes in at UnobservedApproachSpeed in bursts with short pauses, always walking, never a teleport; the
--   observed/unobserved switch needs observeHysteresis seconds, so small camera turns never make it flicker)
--   -> LeapWindup (Fase 4: in LeapMin..LeapMax with a clear line, LeapTelegraphSeconds; the landing circle follows the
--   target and freezes at the end of the windup; registered with the perfect dodge for windup + travel)
--   -> LeapCommit (LeapTravelSeconds on a fixed arc, no correction) -> Land, or OverrunStunned (a validated perfect
--   dodge: it lands LeapOverrunDistanceStuds past the spot and is stunned PerfectDodgeStunSeconds)
--   -> Stalk (LeapCooldownSeconds before the next leap) ... -> Disengage (escape, timeout) -> End.
-- The observation is target.observe(point, halfAngle, maxDist, favour): favour is true here, so a short gap in the
-- camera data reads as "observed" (Lurker waits); the data never decides a hit. Every number is Config.BEASTS.Lurker
-- (tuning = PROPUESTA DE BALANCE).
local DataModel = script:FindFirstAncestorOfClass("DataModel") :: any
local Config = require(DataModel:GetService("ReplicatedStorage"):WaitForChild("WildboundBeastConfig"))
local Attack = require(DataModel:GetService("ServerScriptService"):WaitForChild("WildboundBeastAttack"))
local Lurker = {}

local finite, unit = Config.finite, Config.unit
local copy, emit = Attack.copy, Attack.emit

function Lurker.init(e, now)
	e.seen, e.rawSeen, e.rawSince = false, false, now
	e.leapReadyAt, e.pauseUntil, e.burstAt = -math.huge, -math.huge, now
end

local function observedRaw(e, target, C)
	if type(target.observe) ~= "function" then return false end
	local body = { x = e.pos.x, y = e.pos.y + 1.5, z = e.pos.z }
	return target.observe(body, C.observeCone, C.escapeDistance, true) == true
end

-- Hysteresis: the reported state changes only after the raw observation held for observeHysteresis seconds.
function Lurker.see(e, now, raw, C)
	if raw ~= e.rawSeen then e.rawSeen, e.rawSince = raw, now end
	if e.rawSeen ~= e.seen and now - e.rawSince >= C.observeHysteresis then
		e.seen = e.rawSeen
		return true
	end
	return false
end

local function landingCircle(dest, C)
	return { kind = "circle", x = dest.x, y = dest.y, z = dest.z, r = C.leapRadius }
end

local function startLeap(events, e, now, target, world, C, T)
	local dest = { x = target.x, y = Attack.groundAt(world, target.x, target.z, target.y - 3), z = target.z }
	local strikeAt = now + T.LeapTelegraphSeconds + T.LeapTravelSeconds
	-- BR6 (odd/tasks/wildbound-beast-revision.md): the landing circle is hidden (never drawn); the crouch is the only cue.
	local attack = Attack.open(events, e, world, { key = "leap", startAt = now, strikeAt = strikeAt, dodgeable = true,
		damage = T.LeapDamage, lockAt = now + T.LeapTelegraphSeconds, shape = landingCircle(dest, C), hidden = C.hideTells })
	if not attack then return false end
	e.leap, e.dest, e.leapAt = attack, dest, now + T.LeapTelegraphSeconds
	Attack.face(e, target)
	Attack.phase(events, e, "LeapWindup", now, e.leapAt)
	return true
end

local function stalk(events, e, at, T)
	Attack.phase(events, e, e.seen and "StalkObserved" or "CoverApproach", at)
end

function Lurker.step(events, e, now, target, world, dt)
	local C = Config.BEASTS.Lurker
	local T = C.tuning
	local busy = e.phase == "LeapWindup" or e.phase == "LeapCommit"
	if Attack.guard(events, e, now, target, { timeout = T.EncounterTimeoutSeconds, escapeDistance = C.escapeDistance,
		escapeSeconds = C.escapeSeconds, busy = busy, disengage = C.disengage }) then return end

	if e.phase == "Spawn" then
		Attack.phase(events, e, "Presence", e.phaseAt, e.phaseAt + C.presenceSeconds)
	end
	local changed = Lurker.see(e, now, observedRaw(e, target, C), C)
	if e.phase == "Presence" then
		-- Fase 1: clues only. It keeps its distance and never leaps.
		Attack.face(e, target)
		if now - e.phaseAt >= C.presenceSeconds then
			stalk(events, e, e.phaseAt + C.presenceSeconds, T)
			if e.seen then e.pauseUntil = now + T.ObservedPauseSeconds end
		end
		return
	end
	if (e.phase == "StalkObserved" or e.phase == "CoverApproach") and changed then
		if e.seen then e.pauseUntil = now + T.ObservedPauseSeconds else e.burstAt = now end
		stalk(events, e, now, T)
	end
	if e.phase == "StalkObserved" then
		Attack.face(e, target)
		if now >= e.pauseUntil then Attack.walk(e, target, T.ObservedRetreatSpeedStudsPerSecond, -1, dt, world) end
	elseif e.phase == "CoverApproach" then
		local distance = Attack.distance(e, target)
		local clear = not world.lineOfSight or world.lineOfSight(e.pos, target) == true
		if now >= e.leapReadyAt and distance >= T.LeapMinDistanceStuds and distance <= T.LeapMaxDistanceStuds and clear then
			startLeap(events, e, now, target, world, C, T)
		elseif distance < T.LeapMinDistanceStuds then
			Attack.walk(e, target, T.ObservedRetreatSpeedStudsPerSecond, -1, dt, world)
		else
			-- Bursts: burstSeconds of movement, pauseSeconds still, repeated.
			local cycle = (now - e.burstAt) % (C.burstSeconds + C.pauseSeconds)
			if cycle < C.burstSeconds and distance > T.LeapMinDistanceStuds then
				Attack.walk(e, target, T.UnobservedApproachSpeedStudsPerSecond, 1, dt, world)
			else
				Attack.face(e, target)
			end
		end
	end
	if e.phase == "LeapWindup" then
		local attack = e.leap
		if now < e.leapAt then
			-- The landing spot follows the target until the windup ends.
			e.dest = { x = target.x, y = Attack.groundAt(world, target.x, target.z, target.y - 3), z = target.z }
			Attack.face(e, target)
			Attack.aim(events, e, attack, landingCircle(e.dest, C), now)
		else
			-- The spot is fixed now. A spot with no ground, in a safe zone, or far beyond the leap's reach (the target
			-- teleported) calls the leap off: no strike.
			local y = e.dest.y
			if world.landing then y = world.landing(e.dest.x, e.dest.z, e.dest.y) end
			local reach = Config.flat(e.pos.x, e.pos.z, e.dest.x, e.dest.z)
			if not finite(y) or reach > T.LeapMaxDistanceStuds + T.LeapOverrunDistanceStuds then
				Attack.drop(events, e, world, attack, e.leapAt, "NoLanding")
				e.leap, e.leapReadyAt = nil, now + 1
				stalk(events, e, now, T)
			else
				e.dest.y = y
				Attack.lock(events, e, attack, landingCircle(e.dest, C), e.leapAt)
				e.from = copy(e.pos)
				Attack.phase(events, e, "LeapCommit", e.leapAt, attack.strikeAt)
				emit(events, e, "Move", e.leapAt, { kind = "arc", from = copy(e.from), to = copy(e.dest),
					height = C.arcHeight, landAt = attack.strikeAt })
			end
		end
	end
	if e.phase == "LeapCommit" then
		local attack = e.leap
		local t = math.clamp((now - e.leapAt) / T.LeapTravelSeconds, 0, 1)
		e.pos.x, e.pos.y, e.pos.z = Config.arc(e.from.x, e.from.y, e.from.z, e.dest.x, e.dest.y, e.dest.z, C.arcHeight, t)
		if t >= 1 then
			local landAt = attack.strikeAt
			local result
			if Attack.inside(attack.shape, target, e.dest.y, C.hitHeight) then
				result = Attack.hit(events, e, world, attack, landAt)
			else
				result = Attack.miss(events, e, world, attack, landAt)
			end
			e.leap = nil
			e.leapReadyAt = landAt + T.LeapCooldownSeconds
			if result == "Dodged" then
				-- The overrun: it slides past the spot along the leap, stopping short of a wall or a safe zone.
				local dx, dz = unit(e.dest.x - e.from.x, e.dest.z - e.from.z)
				if dx then
					local ox, oz = e.dest.x + dx * T.LeapOverrunDistanceStuds, e.dest.z + dz * T.LeapOverrunDistanceStuds
					local oy = e.dest.y
					if world.landing then oy = world.landing(ox, oz, e.dest.y) end
					if finite(oy) then
						emit(events, e, "Move", landAt, { kind = "slide", from = copy(e.dest), to = { x = ox, y = oy, z = oz },
							untilAt = landAt + 0.3 })
						e.pos.x, e.pos.y, e.pos.z = ox, oy, oz
					end
				end
				e.stunUntil = landAt + T.PerfectDodgeStunSeconds
				Attack.phase(events, e, "OverrunStunned", landAt, e.stunUntil)
			else
				Attack.phase(events, e, "Land", landAt, landAt)
				stalk(events, e, landAt, T)
			end
		end
	end
	if e.phase == "OverrunStunned" and now >= e.stunUntil then
		stalk(events, e, e.stunUntil, T)
		if e.seen then e.pauseUntil = now + T.ObservedPauseSeconds end
	end
end

return Lurker]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX9"><Properties><string name="Name">WildboundBeastAttack</string><ProtectedString name="Source"><![CDATA[-- Wave 2 (odd/tasks/wildbound-beasts-wave2.md, BW2-4): the shared layer of the four new beasts' state machines
-- (Streamer, Root, Gaze, Lurker). Server only and pure: the beast script passes the clock, the target's server state
-- and a world adapter; this module only returns events. One attack is: a telegraph (a "Tell" event with the shape the
-- client draws, which is the exact hit volume, and its server times), registered with the perfect dodge when it can be
-- dodged (world.telegraph -> WildboundDodgeService.telegraph), then exactly one outcome: Attack.hit (the server found
-- the target inside the shape: world.resolve decides "Dodged" or "Hit", once) or Attack.miss (the window closed with
-- nobody inside: world.cancel). A "Hit" event goes to the inventory server's BeastHit (damage and the one egg drop
-- path); nothing is decided by contact events or by the client. Attack.closeAll cancels whatever is open when an
-- encounter ends, so no hit can land after the end. world.claimStrike is the anti-frustration rule of the pack's
-- combinations matrix: two telegraphed strikes on one player never land closer than DIRECTOR.STRIKE_SEPARATION; the
-- later one waits (the state machine retries on its next step).
local Config = require((script:FindFirstAncestorOfClass("DataModel") :: any):GetService("ReplicatedStorage")
	:WaitForChild("WildboundBeastConfig"))
-- Beast revision BR0 (odd/tasks/wildbound-beast-revision.md): the shared chase rules (persistent chase, one end check,
-- the catch-up walk).
local Chase = require((script:FindFirstAncestorOfClass("DataModel") :: any):GetService("ReplicatedStorage")
	:WaitForChild("WildboundBeastChase"))
local Attack = {}

local finite, flat, unit = Config.finite, Config.flat, Config.unit
Attack.TELL_RATE = 0.1 -- a following tell is re-sent at most this often (the client redraws it)

function Attack.copy(p) return { x = p.x, y = p.y, z = p.z } end

function Attack.emit(events, e, kind, at, fields)
	local ev = { type = kind, id = e.id, beast = e.beast, at = at }
	for k, v in pairs(fields or {}) do ev[k] = v end
	table.insert(events, ev)
	return ev
end

-- Sets the phase and tells the client (posture, warning line, sound). `untilAt` is when the phase is planned to end.
function Attack.phase(events, e, phase, at, untilAt, fields)
	e.phase, e.phaseAt = phase, at
	local payload = { phase = phase, untilAt = untilAt }
	for k, v in pairs(fields or {}) do payload[k] = v end
	return Attack.emit(events, e, "Phase", at, payload)
end

function Attack.groundAt(world, x, z, y)
	local value = world.ground and world.ground(x, z, y)
	return finite(value) and value or y
end

-- Walks toward (sign 1) or away from (sign -1) the target at `speed`, on the ground. Never teleports.
function Attack.walk(e, target, speed, sign, dt, world)
	local dx, dz = unit(target.x - e.pos.x, target.z - e.pos.z)
	if not dx then dx, dz = e.dx, e.dz end
	-- BR0: a persistent beast far behind closes in at least at the catch-up speed.
	speed = Chase.walkSpeed(e.beast, speed, flat(e.pos.x, e.pos.z, target.x, target.z), sign)
	e.pos.x += dx * speed * dt * sign
	e.pos.z += dz * speed * dt * sign
	e.pos.y = Attack.groundAt(world, e.pos.x, e.pos.z, e.pos.y)
	e.dx, e.dz = dx, dz
end

-- Faces the target without moving.
function Attack.face(e, target)
	local dx, dz = unit(target.x - e.pos.x, target.z - e.pos.z)
	if dx then e.dx, e.dz = dx, dz end
end

function Attack.distance(e, target)
	return flat(e.pos.x, e.pos.z, target.x, target.z)
end

function Attack.disengage(events, e, reason, at, seconds)
	e.phase, e.phaseAt = "Disengage", at
	e.disengageReason = reason
	e.disengageUntil = at + (seconds or 0.9)
	Attack.emit(events, e, "Disengage", at, { reason = reason, untilAt = e.disengageUntil })
end

function Attack.finish(e, reason, now)
	if e.done then return nil end
	e.done, e.endReason, e.phase = true, reason, "Ended"
	return { type = "End", id = e.id, beast = e.beast, at = now, reason = reason }
end

-- The end checks every wave 2 beast shares. opts = { timeout, escapeDistance, escapeSeconds, busy, disengage }.
-- Death, a respawned body (the beast script passes nil) and a safe zone end the encounter at once; a long absence
-- (escape), the timeout or a caller's reason (lost target) start the retreat. Returns true when nothing else may run.
-- BR0: a persistent beast (WildboundBeastChase.PERSISTENT) skips escape and timeout: only death or a safe zone ends it.
function Attack.guard(events, e, now, target, opts)
	local ended = Chase.ended(target)
	if ended then
		table.insert(events, Attack.finish(e, ended, now))
		return true
	end
	if e.phase == "Disengage" then
		if now >= e.disengageUntil then table.insert(events, Attack.finish(e, e.disengageReason or "Done", e.disengageUntil)) end
		return true
	end
	if Chase.persistent(e.beast) then
		e.farSince = nil
		return false
	end
	if finite(opts.escapeDistance) then
		if Attack.distance(e, target) > opts.escapeDistance then e.farSince = e.farSince or now else e.farSince = nil end
	end
	if opts.busy then return false end
	if e.farSince and now - e.farSince >= (opts.escapeSeconds or 4) then
		Attack.disengage(events, e, "Escape", now, opts.disengage)
		return true
	end
	if finite(opts.timeout) and now - e.startedAt >= opts.timeout then
		Attack.disengage(events, e, "Timeout", now, opts.disengage)
		return true
	end
	return false
end

-- Opens a telegraphed attack. spec = { key, startAt, strikeAt, shape, dodgeable, damage, lockAt }. Returns the attack,
-- or nil and "Stagger" when another strike on this player lands too close (try again on a later step).
function Attack.open(events, e, world, spec)
	e.attackCount = (e.attackCount or 0) + 1
	local id = ("%s:%s:%d"):format(e.id, spec.key, e.attackCount)
	if world.claimStrike and not world.claimStrike(e.id, id, spec.strikeAt) then
		e.attackCount -= 1
		e.staggered = (e.staggered or 0) + 1
		return nil, "Stagger"
	end
	local attack = { id = id, key = spec.key, startAt = spec.startAt, strikeAt = spec.strikeAt, shape = spec.shape,
		dodgeable = spec.dodgeable == true, damage = spec.damage, done = false, sentAt = spec.startAt, locked = false,
		-- BR6: a hidden attack's tell is never drawn by the client (Lurker: no landing circle); its volume, timing and
		-- dodge registration are unchanged, so the server still decides the hit exactly the same way.
		hidden = spec.hidden == true or nil }
	if attack.dodgeable and world.telegraph then
		-- A refusal (a telegraph under 0.8 s) leaves the attack undodgeable; it still lands only where it was drawn.
		attack.registered = world.telegraph(id, e.beast, spec.startAt, spec.strikeAt) == true
	end
	e.open = e.open or {}
	e.open[id] = attack
	Attack.emit(events, e, "Tell", spec.startAt, { tell = id, shape = spec.shape, startAt = spec.startAt,
		strikeAt = spec.strikeAt, lockAt = spec.lockAt, dodgeable = attack.dodgeable, locked = false, hidden = attack.hidden })
	return attack
end

-- Re-aims an attack before its lock (the client redraws the tell). Throttled to TELL_RATE.
function Attack.aim(events, e, attack, shape, now)
	if attack.locked or attack.done then return end
	attack.shape = shape
	if now - attack.sentAt >= Attack.TELL_RATE then
		attack.sentAt = now
		Attack.emit(events, e, "Tell", now, { tell = attack.id, shape = shape, startAt = attack.startAt,
			strikeAt = attack.strikeAt, dodgeable = attack.dodgeable, locked = false, hidden = attack.hidden })
	end
end

-- Freezes the shape: from now on the hit volume never moves.
function Attack.lock(events, e, attack, shape, at)
	if attack.locked or attack.done then return end
	attack.locked = true
	if shape then attack.shape = shape end
	Attack.emit(events, e, "Tell", at, { tell = attack.id, shape = attack.shape, startAt = attack.startAt,
		strikeAt = attack.strikeAt, dodgeable = attack.dodgeable, locked = true, hidden = attack.hidden })
end

local function close(e, attack)
	attack.done = true
	if e.open then e.open[attack.id] = nil end
end

-- Settles a landed attack once: closes it, asks the dodge (only when dodgeable) and emits the Strike. Returns nil when
-- already settled, true when a perfect dodge held the window, false when it landed.
local function land(events, e, world, attack, now)
	if attack.done then return nil end
	close(e, attack)
	local verdict = "Hit"
	if attack.dodgeable and world.resolve then verdict = world.resolve(attack.id, now) end
	if verdict == "Dodged" then
		Attack.emit(events, e, "Strike", now, { tell = attack.id, hit = false, dodged = true })
		return true
	end
	Attack.emit(events, e, "Strike", now, { tell = attack.id, hit = true })
	return false
end

-- The target is inside the attack's volume: the one outcome of this attack. Returns "Dodged" (a perfect dodge held
-- the window: no damage) or "Hit" (a Hit event with the damage and the extra fields). nil when already settled.
function Attack.hit(events, e, world, attack, now, fields)
	local dodged = land(events, e, world, attack, now)
	if dodged == nil then return nil end
	if dodged then return "Dodged" end
	local payload = { damage = attack.damage, attack = attack.id }
	for k, v in pairs(fields or {}) do payload[k] = v end
	Attack.emit(events, e, "Hit", now, payload)
	return "Hit"
end

-- SC2 (odd/tasks/wildbound-scuttler.md): the non-damaging outcome of an attack whose target is inside its volume. The
-- same dodge resolution as Attack.hit, but a landed attack emits an "Afflict" event (the attack id and the extra
-- fields, e.g. a slow and a shake; no damage) and never "Hit", so the beast script applies the effect without reaching
-- BeastHit (damage and the egg drop). Returns "Dodged", "Afflicted", or nil when already settled.
function Attack.afflict(events, e, world, attack, now, fields)
	local dodged = land(events, e, world, attack, now)
	if dodged == nil then return nil end
	if dodged then return "Dodged" end
	local payload = { attack = attack.id }
	for k, v in pairs(fields or {}) do payload[k] = v end
	Attack.emit(events, e, "Afflict", now, payload)
	return "Afflicted"
end

-- The window closed with nobody inside. Returns "Miss" once, nil when already settled.
function Attack.miss(events, e, world, attack, now)
	if attack.done then return nil end
	close(e, attack)
	if attack.dodgeable and world.cancel then world.cancel(attack.id) end
	Attack.emit(events, e, "Strike", now, { tell = attack.id, hit = false })
	return "Miss"
end

-- An attack called off before its strike (the target left, the beast gave up): no strike, the tell goes away.
function Attack.drop(events, e, world, attack, now, reason)
	if attack.done then return end
	close(e, attack)
	if attack.dodgeable and world.cancel then world.cancel(attack.id) end
	Attack.emit(events, e, "TellEnd", now, { tell = attack.id, reason = reason })
end

-- Every attack still open: their ids (sorted). The beast script cancels them with the dodge service on End.
function Attack.openIds(e)
	local ids = {}
	for id in pairs(e.open or {}) do table.insert(ids, id) end
	table.sort(ids)
	return ids
end

-- Ends every open attack without a strike (End, error). Idempotent.
function Attack.closeAll(e, world)
	for _, id in ipairs(Attack.openIds(e)) do
		local attack = e.open[id]
		close(e, attack)
		if attack.dodgeable and world and world.cancel then world.cancel(id) end
	end
end

-- The target's flat point is inside the shape and within `height` studs of `groundY` (the shape's floor).
function Attack.inside(shape, target, groundY, height)
	if not Config.shapeHit(shape, target.x, target.z) then return false end
	return not finite(groundY) or not finite(height) or math.abs(target.y - groundY) <= height
end

return Attack]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX10"><Properties><string name="Name">WildboundBeastProxies</string><ProtectedString name="Source"><![CDATA[-- Nest Heist phase 4a (NB4): stylized Part proxies for the two global beasts, built by the server into
-- ReplicatedStorage.WildboundBeasts.Models so each target client can clone its own visual. They are placeholders, not the
-- final meshes: the uploaded models (EV-W3, Proxies.adopt) replace them when their templates are in ServerStorage.
-- A model named exactly "Viper" or "Pouncer" in that folder (the user's import) always wins over "ViperProxy" and
-- "PouncerProxy", and Proxies.ensure never replaces it. Behaviour never reads the model: hitboxes and timing live in
-- WildboundBeastEncounters, and the red lane and circle are gameplay effects drawn by the client, never part of a model.
-- Orientation: the pivot sits on the ground under the creature and the head faces the pivot's LookVector (-Z).
local Proxies = {}

Proxies.PALETTE = table.freeze({
	viperCharcoal = Color3.fromHex("3A2B46"), viperPlate = Color3.fromHex("584070"), viperPlateLight = Color3.fromHex("6A4A80"),
	viperCrest = Color3.fromHex("80509F"), viperAccent = Color3.fromHex("B8408E"), viperJaw = Color3.fromHex("CBB39C"),
	viperFang = Color3.fromHex("EFE4CC"), viperMouth = Color3.fromHex("A02A62"), viperEye = Color3.fromHex("FF7A0A"),
	pouncerCharcoal = Color3.fromHex("352A3F"), pouncerPlum = Color3.fromHex("5E4568"), pouncerPlumDark = Color3.fromHex("4A3854"),
	pouncerViolet = Color3.fromHex("7B5288"), pouncerMagenta = Color3.fromHex("A8407F"), pouncerIvory = Color3.fromHex("E6D7C0"),
	pouncerEye = Color3.fromHex("FF3FC0"),
	-- Kids biome: La Nube Gruñona and La Abeja Reina (soft, friendly colours; never a red danger colour).
	nubePuff = Color3.fromHex("B4A8D2"), nubeBelly = Color3.fromHex("8C7FB0"), nubeEye = Color3.fromHex("FFFFFF"),
	nubePupil = Color3.fromHex("2E2840"), nubeBrow = Color3.fromHex("5E5480"), nubeShadow = Color3.fromHex("3A3550"),
	abejaYellow = Color3.fromHex("FFD54A"), abejaBrown = Color3.fromHex("B8793A"), abejaWing = Color3.fromHex("E8F4FF"),
	abejaCrown = Color3.fromHex("F7E3A1"), abejaTip = Color3.fromHex("FFE27A"), abejaEye = Color3.fromHex("2E2418"),
})
local C = Proxies.PALETTE

local function part(model, name, size, cframe, color, kind)
	local value = Instance.new(kind or "Part")
	value.Name = name
	value.Size = size
	value.CFrame = cframe
	value.Color = color
	value.Material = Enum.Material.SmoothPlastic
	value.TopSurface, value.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
	-- A visual only: never collides, never answers a query, never fires contact events, never simulated.
	value.Anchored, value.CanCollide, value.CanQuery, value.CanTouch, value.Massless = true, false, false, false, true
	value.Parent = model
	return value
end

local function eye(model, name, size, cframe, color, shape)
	local value = part(model, name, size, cframe, color)
	value.Material = Enum.Material.Neon
	if shape then value.Shape = shape end
	return value
end

-- A block from a to b (Vector3), `thick` studs square.
local function segment(model, name, a, b, thick, color)
	local length = (b - a).Magnitude
	return part(model, name, Vector3.new(thick, thick, length), CFrame.lookAt((a + b) / 2, b), color)
end

local function finish(model, beast, root)
	model.PrimaryPart = root
	model:SetAttribute("Beast", beast)
	model:SetAttribute("Proxy", true)
	model:SetAttribute("ProxyNote", "Stylized Part placeholder. Import the mesh from assets/models/beasts/ as a model named "
		.. beast .. " in ReplicatedStorage.WildboundBeasts.Models to replace it.")
	return model
end

-- Viper: a thick segmented coil (purple-charcoal plates over a beige belly), a neck rising to a big wedge head with a beige
-- jaw, two ivory fangs, a violet crest and amber Neon eyes. About 10 studs long and 6 tall.
function Proxies.viper()
	local model = Instance.new("Model")
	model.Name = "ViperProxy"
	local root = part(model, "Root", Vector3.new(1, 0.2, 1), CFrame.new(0, 0.1, 0), C.viperCharcoal)
	root.Transparency = 1
	local centre, radius, count = Vector3.new(0, 0, 2.4), 3, 9
	for i = 1, count do
		-- The coil: segments around a ring, shrinking toward the tail, with alternating plate colours.
		local a = (i - 1) / count * math.pi * 2 + math.pi * 0.6
		local scale = 1 - (i - 1) * 0.06
		local at = centre + Vector3.new(math.cos(a) * radius, 0.95 * scale, math.sin(a) * radius)
		local tangent = Vector3.new(-math.sin(a), 0, math.cos(a))
		local frame = CFrame.lookAt(at, at + tangent)
		part(model, "Coil" .. i, Vector3.new(2.3, 1.9, 2.4) * scale, frame, i % 2 == 0 and C.viperPlate or C.viperCharcoal)
		part(model, "Belly" .. i, Vector3.new(1.6, 0.5, 2.3) * scale, frame * CFrame.new(0, -0.75 * scale, 0), C.viperJaw)
		if i % 3 == 1 then
			part(model, "Accent" .. i, Vector3.new(0.4, 0.5, 1.4) * scale, frame * CFrame.new(0, 0.95 * scale, 0), C.viperAccent, "WedgePart")
		end
	end
	local neck = { Vector3.new(0, 1.4, -0.2), Vector3.new(0, 2.8, -0.9), Vector3.new(0, 4.0, -1.5) }
	for i = 1, #neck - 1 do
		segment(model, "Neck" .. i, neck[i], neck[i + 1], 1.9 - i * 0.15, C.viperPlate)
		local mid = (neck[i] + neck[i + 1]) / 2
		part(model, "NeckPlate" .. i, Vector3.new(1.3, 1.4, 0.4), CFrame.lookAt(mid + Vector3.new(0, 0, -0.85), mid + Vector3.new(0, 0, -3)),
			C.viperJaw)
	end
	local head = CFrame.new(0, 4.7, -2.7)
	part(model, "Head", Vector3.new(3.2, 1.5, 3.4), head, C.viperPlateLight)
	part(model, "Snout", Vector3.new(2.6, 1.1, 1.4), head * CFrame.new(0, -0.1, -2.3) * CFrame.Angles(0, math.pi, 0), C.viperPlate, "WedgePart")
	part(model, "Jaw", Vector3.new(2.7, 0.6, 3.4), head * CFrame.new(0, -1.25, -0.5), C.viperJaw)
	part(model, "Mouth", Vector3.new(2.2, 0.4, 2.8), head * CFrame.new(0, -0.85, -0.6), C.viperMouth)
	part(model, "Tongue", Vector3.new(0.25, 0.12, 1.6), head * CFrame.new(0, -0.9, -2.6), C.viperMouth)
	for _, side in ipairs({ -1, 1 }) do
		part(model, "Fang" .. (side < 0 and "L" or "R"), Vector3.new(0.3, 1.3, 0.35),
			head * CFrame.new(side * 0.85, -1.1, -2.2) * CFrame.Angles(math.pi, 0, 0), C.viperFang, "WedgePart")
		eye(model, "Eye" .. (side < 0 and "L" or "R"), Vector3.new(0.55, 0.3, 0.5), head * CFrame.new(side * 1.05, 0.45, -1.4)
			* CFrame.Angles(0, 0, side * 0.35), C.viperEye)
	end
	for i = 1, 3 do
		part(model, "Crest" .. i, Vector3.new(0.5, 0.9, 1.4), head * CFrame.new(0, 0.95, 1.2 - i * 0.9), C.viperCrest, "WedgePart")
	end
	return finish(model, "Viper", root)
end

-- Pouncer: a broad, low plum body with a darker abdomen, a charcoal head with ivory fangs, a cluster of magenta Neon
-- eyes, and eight long angular legs (a femur up to the knee, a tibia down to an ivory claw). About 9 studs across.
function Proxies.pouncer()
	local model = Instance.new("Model")
	model.Name = "PouncerProxy"
	local root = part(model, "Root", Vector3.new(1, 0.2, 1), CFrame.new(0, 0.1, 0), C.pouncerCharcoal)
	root.Transparency = 1
	part(model, "Body", Vector3.new(4, 2, 3.6), CFrame.new(0, 2.5, -0.6), C.pouncerPlum)
	part(model, "BodyRidge", Vector3.new(2.4, 0.8, 2.6), CFrame.new(0, 3.8, -0.6), C.pouncerViolet, "WedgePart")
	local abdomen = part(model, "Abdomen", Vector3.new(4.2, 3.4, 4.4), CFrame.new(0, 3.1, 2.8), C.pouncerPlumDark)
	abdomen.Shape = Enum.PartType.Ball
	part(model, "AbdomenMark", Vector3.new(1.6, 0.6, 2.4), CFrame.new(0, 4.75, 2.8), C.pouncerMagenta, "WedgePart")
	local head = CFrame.new(0, 2.3, -2.9)
	part(model, "Head", Vector3.new(2.6, 1.6, 1.6), head, C.pouncerCharcoal)
	for _, side in ipairs({ -1, 1 }) do
		local tag = side < 0 and "L" or "R"
		eye(model, "Eye" .. tag, Vector3.new(0.75, 0.75, 0.75), head * CFrame.new(side * 0.55, 0.25, -0.75), C.pouncerEye, Enum.PartType.Ball)
		eye(model, "EyeSmall" .. tag, Vector3.new(0.35, 0.35, 0.35), head * CFrame.new(side * 0.4, 0.7, -0.72), C.pouncerEye, Enum.PartType.Ball)
		part(model, "Fang" .. tag, Vector3.new(0.45, 1.5, 0.45), head * CFrame.new(side * 0.6, -1.25, -0.6) * CFrame.Angles(math.pi, 0, 0),
			C.pouncerIvory, "WedgePart")
	end
	for _, side in ipairs({ -1, 1 }) do
		for i, z in ipairs({ -1.9, -0.9, 0.1, 1.1 }) do
			local tag = (side < 0 and "L" or "R") .. i
			local spread = 1 + (i - 2.5) * 0.25
			local hip = Vector3.new(side * 1.9, 2.4, z)
			local knee = Vector3.new(side * 4.0, 4.3, z * 1.5 * spread)
			local foot = Vector3.new(side * 5.2, 0.15, z * 2 * spread)
			segment(model, "Femur" .. tag, hip, knee, 0.7, C.pouncerCharcoal)
			local claw = knee:Lerp(foot, 0.75)
			segment(model, "Tibia" .. tag, knee, claw, 0.6, i % 2 == 0 and C.pouncerPlum or C.pouncerCharcoal)
			segment(model, "Claw" .. tag, claw, foot, 0.4, C.pouncerIvory)
		end
	end
	return finish(model, "Pouncer", root)
end

-- Wave 2 (odd/tasks/wildbound-beasts-wave2.md): Part blockouts of the four new beasts after the pack's sheets
-- (03_IMAGENES/<X>/<X>_00_FICHA_COMPLETA.png): purple-grey bodies, one danger colour each. Placeholders only: a model
-- named exactly "Streamer", "Root", "Gaze" or "Lurker" in ReplicatedStorage.WildboundBeasts.Models replaces them.
local W = table.freeze({
	plum = Color3.fromHex("4A3858"), plumLight = Color3.fromHex("6E5482"), bone = Color3.fromHex("D9C6D6"),
	moss = Color3.fromHex("8C9A3C"), bark = Color3.fromHex("5A4436"), barkDark = Color3.fromHex("3E2F26"),
	magenta = Color3.fromHex("FF2E9A"), shadow = Color3.fromHex("1E1726"), violet = Color3.fromHex("A050FF"),
	fuchsia = Color3.fromHex("FF46C8"), green = Color3.fromHex("82EB5A"),
})
Proxies.WAVE2_PALETTE = W

-- Streamer: a hunched semi-humanoid about 9 studs tall, very long arms reaching the ground, spring legs, a cavernous
-- mouth with a magenta Neon core, bone spikes and moss tufts on the back.
function Proxies.streamer()
	local model = Instance.new("Model")
	model.Name = "StreamerProxy"
	local root = part(model, "Root", Vector3.new(1, 0.2, 1), CFrame.new(0, 0.1, 0), W.plum)
	root.Transparency = 1
	part(model, "Pelvis", Vector3.new(2.6, 1.6, 2), CFrame.new(0, 4.2, 0.6), W.plum)
	part(model, "Chest", Vector3.new(3.6, 2.6, 2.8), CFrame.new(0, 6, -0.6) * CFrame.Angles(math.rad(-25), 0, 0), W.plumLight)
	local head = CFrame.new(0, 7.2, -2.6)
	part(model, "Head", Vector3.new(2.4, 1.8, 2.4), head, W.plum)
	part(model, "Jaw", Vector3.new(2.2, 0.7, 2.2), head * CFrame.new(0, -1.4, -0.3) * CFrame.Angles(math.rad(25), 0, 0), W.bone)
	eye(model, "MouthCore", Vector3.new(1.3, 1, 0.4), head * CFrame.new(0, -0.6, -1.2), W.magenta)
	for _, side in ipairs({ -1, 1 }) do
		local tag = side < 0 and "L" or "R"
		eye(model, "Eye" .. tag, Vector3.new(0.35, 0.35, 0.35), head * CFrame.new(side * 0.6, 0.5, -1.2), W.magenta, Enum.PartType.Ball)
		segment(model, "UpperArm" .. tag, Vector3.new(side * 2, 6.6, -1.2), Vector3.new(side * 3.4, 4, -2.6), 0.8, W.plumLight)
		segment(model, "Forearm" .. tag, Vector3.new(side * 3.4, 4, -2.6), Vector3.new(side * 3, 0.6, -4), 0.7, W.plum)
		part(model, "Claw" .. tag, Vector3.new(1.4, 0.4, 1.6), CFrame.new(side * 3, 0.3, -4.4), W.bone, "WedgePart")
		segment(model, "Thigh" .. tag, Vector3.new(side * 1, 4, 0.8), Vector3.new(side * 1.6, 2.4, -0.6), 0.8, W.plum)
		segment(model, "Shin" .. tag, Vector3.new(side * 1.6, 2.4, -0.6), Vector3.new(side * 1.4, 0.3, 1), 0.6, W.plumLight)
		part(model, "Moss" .. tag, Vector3.new(0.8, 0.5, 1.4), CFrame.new(side * 1.2, 7.2, 0.2), W.moss)
	end
	for i = 1, 4 do
		part(model, "Spike" .. i, Vector3.new(0.4, 1.2, 0.8), CFrame.new(0, 7.4 - i * 0.5, -1 + i * 0.7), W.bone, "WedgePart")
	end
	return finish(model, "Streamer", root)
end

-- Root: a broad tree-like body of bark about 10 studs tall, branched horns with moss, two long whip arms and root feet
-- spread on the ground, with green glowing knots.
function Proxies.root()
	local model = Instance.new("Model")
	model.Name = "RootProxy"
	local root = part(model, "Root", Vector3.new(1, 0.2, 1), CFrame.new(0, 0.1, 0), W.bark)
	root.Transparency = 1
	part(model, "Trunk", Vector3.new(4.4, 5, 3.4), CFrame.new(0, 3.6, 0), W.bark)
	part(model, "Shoulders", Vector3.new(5.6, 1.8, 3.2), CFrame.new(0, 6.6, -0.2), W.barkDark)
	local head = CFrame.new(0, 7.9, -1)
	part(model, "Head", Vector3.new(2.4, 1.8, 2), head, W.bark)
	for _, side in ipairs({ -1, 1 }) do
		local tag = side < 0 and "L" or "R"
		eye(model, "Eye" .. tag, Vector3.new(0.4, 0.3, 0.3), head * CFrame.new(side * 0.6, 0.2, -1.05), W.green)
		segment(model, "Horn" .. tag, Vector3.new(side * 0.8, 8.6, -1), Vector3.new(side * 2.2, 10.4, -0.6), 0.45, W.barkDark)
		segment(model, "HornTip" .. tag, Vector3.new(side * 2.2, 10.4, -0.6), Vector3.new(side * 3.2, 10.6, -1.4), 0.3, W.barkDark)
		part(model, "HornMoss" .. tag, Vector3.new(0.8, 0.4, 0.8), CFrame.new(side * 2.2, 10.5, -0.6), W.moss)
		segment(model, "WhipUpper" .. tag, Vector3.new(side * 2.8, 6.6, -0.4), Vector3.new(side * 4.6, 4.2, -1.6), 0.8, W.bark)
		segment(model, "WhipLower" .. tag, Vector3.new(side * 4.6, 4.2, -1.6), Vector3.new(side * 5.2, 0.6, -3.4), 0.5, W.barkDark)
		for i, z in ipairs({ -1.6, 0, 1.6 }) do
			segment(model, "Foot" .. tag .. i, Vector3.new(side * 1.6, 1.4, z), Vector3.new(side * 3.4, 0.2, z * 1.6), 0.6, W.barkDark)
		end
	end
	for i = 1, 3 do
		eye(model, "Knot" .. i, Vector3.new(0.5, 0.5, 0.2), CFrame.new(-1 + i * 0.6, 2.4 + i * 1.1, -1.75), W.green)
	end
	part(model, "BackMoss", Vector3.new(3.6, 0.6, 2.6), CFrame.new(0, 7.6, 0.6), W.moss)
	return finish(model, "Root", root)
end

-- Gaze: a thin, almost weightless dark silhouette about 11 studs tall with two giant magenta Neon eyes, long fingers
-- framing the face and a frayed lower body that does not touch the ground.
function Proxies.gaze()
	local model = Instance.new("Model")
	model.Name = "GazeProxy"
	local root = part(model, "Root", Vector3.new(1, 0.2, 1), CFrame.new(0, 0.1, 0), W.shadow)
	root.Transparency = 1
	part(model, "Body", Vector3.new(1.6, 5, 1.2), CFrame.new(0, 6, 0), W.shadow)
	for i = 1, 4 do
		part(model, "Tatter" .. i, Vector3.new(0.4, 2.4, 0.4), CFrame.new(-0.9 + i * 0.4, 2.6, (i % 2) * 0.3)
			* CFrame.Angles(0, 0, math.rad((i - 2.5) * 8)), W.plum)
	end
	local head = CFrame.new(0, 10, -0.2)
	part(model, "Head", Vector3.new(2.6, 2.4, 1.6), head, W.shadow)
	for _, side in ipairs({ -1, 1 }) do
		local tag = side < 0 and "L" or "R"
		eye(model, "Eye" .. tag, Vector3.new(0.95, 0.95, 0.95), head * CFrame.new(side * 0.62, 0.1, -0.7), W.magenta, Enum.PartType.Ball)
		segment(model, "Arm" .. tag, Vector3.new(side * 0.9, 8.2, 0), Vector3.new(side * 1.8, 9.4, -1.2), 0.35, W.plum)
		for f = 1, 3 do
			segment(model, "Finger" .. tag .. f, Vector3.new(side * 1.8, 9.4, -1.2),
				Vector3.new(side * (1.2 + f * 0.15), 9.6 + f * 0.5, -1.4), 0.18, W.plumLight)
		end
	end
	return finish(model, "Gaze", root)
end

-- Lurker: a low, long-limbed predator about 9 studs long and 3.5 tall on four angular legs, a ridge of spines and
-- fuchsia Neon eyes.
function Proxies.lurker()
	local model = Instance.new("Model")
	model.Name = "LurkerProxy"
	local root = part(model, "Root", Vector3.new(1, 0.2, 1), CFrame.new(0, 0.1, 0), W.plum)
	root.Transparency = 1
	part(model, "Body", Vector3.new(2.4, 1.5, 5), CFrame.new(0, 2.4, 0.4), W.plum)
	local head = CFrame.new(0, 2.5, -2.8)
	part(model, "Head", Vector3.new(1.8, 1.1, 1.8), head, W.plumLight)
	part(model, "Snout", Vector3.new(1.4, 0.6, 1), head * CFrame.new(0, -0.2, -1.3) * CFrame.Angles(0, math.pi, 0), W.plum, "WedgePart")
	for _, side in ipairs({ -1, 1 }) do
		local tag = side < 0 and "L" or "R"
		eye(model, "Eye" .. tag, Vector3.new(0.35, 0.25, 0.3), head * CFrame.new(side * 0.5, 0.25, -0.9), W.fuchsia)
		for i, z in ipairs({ -1.6, 2.2 }) do
			local leg = tag .. i
			local hip = Vector3.new(side * 1.1, 2.4, z)
			local knee = Vector3.new(side * 2.4, 3.4, z - 0.6)
			local foot = Vector3.new(side * 2.6, 0.15, z - 1.2)
			segment(model, "Thigh" .. leg, hip, knee, 0.5, W.plum)
			segment(model, "Shin" .. leg, knee, foot, 0.35, W.plumLight)
			part(model, "Claw" .. leg, Vector3.new(0.6, 0.3, 0.8), CFrame.new(foot.X, 0.15, foot.Z - 0.3), W.bone, "WedgePart")
		end
	end
	for i = 1, 6 do
		part(model, "Spine" .. i, Vector3.new(0.25, 0.9 + (i % 2) * 0.3, 0.6), CFrame.new(0, 3.5, -1.6 + i * 0.7), W.bone, "WedgePart")
	end
	segment(model, "Tail", Vector3.new(0, 2.4, 2.9), Vector3.new(0, 1.6, 5.4), 0.35, W.plum)
	return finish(model, "Lurker", root)
end

-- Kids biome (odd/tasks/wildbound-kids-beasts.md): La Nube Gruñona, a grumpy storm cloud about 14 x 8 studs: five
-- lilac-grey puff balls over a darker belly, white eye discs with frowning brow bars, hovering HoverStuds over a
-- translucent shadow disc on the ground (the pivot stays on the ground, like every proxy).
function Proxies.nube()
	local model = Instance.new("Model")
	model.Name = "NubeGrunonaProxy"
	local root = part(model, "Root", Vector3.new(1, 0.2, 1), CFrame.new(0, 0.1, 0), C.nubeShadow)
	root.Transparency = 1
	local h = 10 -- Config.BEASTS.NubeGrunona.tuning.HoverStuds (the proxies never require the config)
	local shadow = part(model, "Shadow", Vector3.new(0.1, 40, 40), CFrame.new(0, 0.12, 0) * CFrame.Angles(0, 0, math.pi / 2),
		C.nubeShadow)
	shadow.Shape = Enum.PartType.Cylinder
	shadow.Transparency = 0.75
	for i, spec in ipairs({ { 0, 1.2, 0, 8 }, { -4, 0, 0.4, 6 }, { 4, 0, 0.4, 6 }, { -2, 1.6, 1.4, 5.5 }, { 2.4, 1.8, 1.2, 5 } }) do
		local puff = part(model, "Puff" .. i, Vector3.new(spec[4], spec[4], spec[4]), CFrame.new(spec[1], h + spec[2], spec[3]),
			C.nubePuff)
		puff.Shape = Enum.PartType.Ball
	end
	local belly = part(model, "Belly", Vector3.new(12, 2.4, 6), CFrame.new(0, h - 2.4, 0.4), C.nubeBelly)
	belly.Shape = Enum.PartType.Block
	local head = CFrame.new(0, h + 0.6, -3.7)
	part(model, "Head", Vector3.new(4, 2.6, 0.4), head, C.nubePuff)
	for _, side in ipairs({ -1, 1 }) do
		local tag = side < 0 and "L" or "R"
		local disc = part(model, "Eye" .. tag, Vector3.new(0.2, 1.6, 1.6), head * CFrame.new(side * 1.1, 0, -0.3)
			* CFrame.Angles(0, math.pi / 2, 0), C.nubeEye, "Part")
		disc.Shape = Enum.PartType.Cylinder
		disc.Material = Enum.Material.Neon
		local pupil = part(model, "Pupil" .. tag, Vector3.new(0.2, 0.7, 0.7), head * CFrame.new(side * 1.1, -0.2, -0.45)
			* CFrame.Angles(0, math.pi / 2, 0), C.nubePupil)
		pupil.Shape = Enum.PartType.Cylinder
		part(model, "Brow" .. tag, Vector3.new(1.8, 0.35, 0.4), head * CFrame.new(side * 1.1, 1.1, -0.45)
			* CFrame.Angles(0, 0, math.rad(side * -18)), C.nubeBrow)
	end
	return finish(model, "NubeGrunona", root)
end

-- Kids biome: La Abeja Reina, a round queen bee hovering HoverStuds up: an ellipsoid body with alternating yellow and
-- brown bands, two translucent wings, a wax crown, antennae with Neon tips and dark eyes.
function Proxies.abeja()
	local model = Instance.new("Model")
	model.Name = "AbejaReinaProxy"
	local root = part(model, "Root", Vector3.new(1, 0.2, 1), CFrame.new(0, 0.1, 0), C.abejaBrown)
	root.Transparency = 1
	local h = 6 -- Config.BEASTS.AbejaReina.tuning.HoverStuds
	for i, z in ipairs({ -1.2, -0.4, 0.4, 1.2, 2 }) do
		local size = 3.2 - math.abs(z - 0.2) * 0.5
		local band = part(model, "Band" .. i, Vector3.new(size, size, 0.8), CFrame.new(0, h, z), i % 2 == 1 and C.abejaYellow
			or C.abejaBrown)
		band.Shape = Enum.PartType.Ball
	end
	local head = CFrame.new(0, h + 0.4, -2.2)
	local headPart = part(model, "Head", Vector3.new(2, 2, 2), head, C.abejaYellow)
	headPart.Shape = Enum.PartType.Ball
	for _, side in ipairs({ -1, 1 }) do
		local tag = side < 0 and "L" or "R"
		local eyeBall = part(model, "Eye" .. tag, Vector3.new(0.6, 0.6, 0.6), head * CFrame.new(side * 0.55, 0.2, -0.8), C.abejaEye)
		eyeBall.Shape = Enum.PartType.Ball
		local wing = part(model, "Wing" .. tag, Vector3.new(3, 0.15, 1.8), CFrame.new(side * 1.9, h + 1.6, 0)
			* CFrame.Angles(0, 0, math.rad(side * 20)), C.abejaWing)
		wing.Transparency = 0.55
		segment(model, "Antenna" .. tag, head.Position + Vector3.new(side * 0.4, 0.9, -0.3),
			head.Position + Vector3.new(side * 0.9, 2, -0.8), 0.15, C.abejaBrown)
		eye(model, "AntennaTip" .. tag, Vector3.new(0.45, 0.45, 0.45), CFrame.new(head.Position + Vector3.new(side * 0.9, 2, -0.8)),
			C.abejaTip, Enum.PartType.Ball)
	end
	part(model, "Crown", Vector3.new(1.4, 0.6, 1.4), head * CFrame.new(0, 1.1, 0.1), C.abejaCrown)
	for i = 1, 3 do
		part(model, "CrownPoint" .. i, Vector3.new(0.3, 0.6, 0.3), head * CFrame.new(-0.5 + (i - 1) * 0.5, 1.6, 0.1), C.abejaCrown)
	end
	part(model, "Stinger", Vector3.new(0.4, 0.4, 0.8), CFrame.new(0, h - 0.2, 2.8), C.abejaBrown, "WedgePart")
	return finish(model, "AbejaReina", root)
end

-- Scuttler (docs/design/wildbound-scuttler-plan.md section 10, SC8): the global threat-3 insect, a Part placeholder until
-- its rig (SC9) and the approved mesh upload (SC10). Maroon carapace with cream chevrons, moss accents, amber Neon eyes and
-- antenna tips (the client flashes them at a real lock), two claw arms with A/B pincers and eight legs. 12-14 studs tall
-- (owner decision Q1). A model named exactly "Scuttler" in ReplicatedStorage.WildboundBeasts.Models replaces it.
local S = table.freeze({
	carapace = Color3.fromHex("6E2A35"), carapaceDark = Color3.fromHex("4A1C26"), chevron = Color3.fromHex("EADBB8"),
	moss = Color3.fromHex("7E8F3A"), eye = Color3.fromHex("FFB020"), claw = Color3.fromHex("E3D3B4"),
})
Proxies.SCUTTLER_PALETTE = S

function Proxies.scuttler()
	local model = Instance.new("Model")
	model.Name = "ScuttlerProxy"
	local root = part(model, "Root", Vector3.new(1, 0.2, 1), CFrame.new(0, 0.1, 0), S.carapaceDark)
	root.Transparency = 1
	part(model, "Abdomen", Vector3.new(7, 4.5, 8), CFrame.new(0, 6.5, 4) * CFrame.Angles(math.rad(-8), 0, 0), S.carapace)
	for i = 1, 4 do
		-- Chevrons along the back point forward (toward the head).
		part(model, "Chevron" .. i, Vector3.new(2.6 - i * 0.2, 0.5, 1.2), CFrame.new(0, 9.1 - i * 0.12, 0.6 + i * 1.6)
			* CFrame.Angles(0, math.pi, 0), S.chevron, "WedgePart")
	end
	part(model, "Thorax", Vector3.new(5, 4, 4.2), CFrame.new(0, 8.2, -1.2) * CFrame.Angles(math.rad(18), 0, 0), S.carapaceDark)
	local head = CFrame.new(0, 10.4, -4.5)
	part(model, "Head", Vector3.new(3.6, 3, 3), head, S.carapace)
	part(model, "HeadPlate", Vector3.new(2.6, 1, 2.6), head * CFrame.new(0, 2, 0.3), S.carapaceDark, "WedgePart")
	part(model, "Jaw", Vector3.new(2.4, 0.6, 1.2), head * CFrame.new(0, -1.3, -1.5), S.claw)
	for _, side in ipairs({ -1, 1 }) do
		local tag = side < 0 and "L" or "R"
		eye(model, "Eye" .. tag, Vector3.new(0.8, 0.8, 0.8), head * CFrame.new(side * 0.9, 0.4, -1.45), S.eye, Enum.PartType.Ball)
		eye(model, "EyeSmall" .. tag, Vector3.new(0.45, 0.45, 0.45), head * CFrame.new(side * 0.45, 1, -1.4), S.eye,
			Enum.PartType.Ball)
		local base, tip = Vector3.new(side * 0.8, 11.8, -5.5), Vector3.new(side * 2.2, 13.4, -7.2)
		segment(model, "Antenna" .. tag, base, tip, 0.25, S.carapaceDark)
		eye(model, "AntennaTip" .. tag, Vector3.new(0.5, 0.5, 0.5), CFrame.new(tip), S.eye, Enum.PartType.Ball)
		-- The claw arm: shoulder, upper arm, forearm, and the two pincer blades (A above, B below).
		local shoulder, elbow, wrist = Vector3.new(side * 2.4, 8.8, -2.8), Vector3.new(side * 4.6, 10.2, -5.2),
			Vector3.new(side * 4, 7.6, -7.6)
		segment(model, "ClawUpper" .. tag, shoulder, elbow, 0.9, S.carapace)
		segment(model, "ClawFore" .. tag, elbow, wrist, 0.8, S.carapaceDark)
		segment(model, "Pincer" .. tag .. "A", wrist, Vector3.new(side * 3.3, 8, -10.2), 0.5, S.claw)
		segment(model, "Pincer" .. tag .. "B", wrist, Vector3.new(side * 4.4, 6.7, -9.8), 0.45, S.claw)
		for i, z in ipairs({ -1.2, 1.2, 3.6, 6 }) do
			local leg = tag .. i
			local hip = Vector3.new(side * 2.8, 6.4, z)
			local knee = Vector3.new(side * 6.4, 9.2, z * 1.15 - 0.4)
			local foot = Vector3.new(side * 8, 0.6, z * 1.3 - 0.6)
			segment(model, "LegUpper" .. leg, hip, knee, 0.7, S.carapaceDark)
			segment(model, "LegLower" .. leg, knee, foot, 0.5, i % 2 == 0 and S.carapace or S.carapaceDark)
		end
		part(model, "Moss" .. tag, Vector3.new(1.6, 0.4, 1.4), CFrame.new(side * 2, 8.6, 5.2), S.moss)
	end
	part(model, "MossThorax", Vector3.new(1.4, 0.4, 1.2), CFrame.new(0.6, 10.2, -1), S.moss)
	part(model, "Tail", Vector3.new(2, 1.4, 2), CFrame.new(0, 5.6, 8.8), S.carapaceDark, "WedgePart")
	return finish(model, "Scuttler", root)
end

Proxies.BUILDERS = table.freeze({ Viper = Proxies.viper, Pouncer = Proxies.pouncer, Streamer = Proxies.streamer,
	Root = Proxies.root, Gaze = Proxies.gaze, Lurker = Proxies.lurker, NubeGrunona = Proxies.nube,
	AbejaReina = Proxies.abeja, Scuttler = Proxies.scuttler })

-- The visual a client clones: the user's imported model when present, else the proxy.
function Proxies.modelFor(models, beast)
	if typeof(models) ~= "Instance" or type(beast) ~= "string" then return nil end
	local real = models:FindFirstChild(beast)
	if real and real:IsA("Model") then return real end
	local proxy = models:FindFirstChild(beast .. "Proxy")
	return proxy and proxy:IsA("Model") and proxy or nil
end

-- EV-W3: the uploaded rigged models live as templates in ServerStorage.WildboundAssets.Beasts (the ids are recorded in
-- assets/models/beasts/uploaded-assets.json). A template is adopted only when it has a "Root" part on the ground with
-- the head along its LookVector (the proxies' convention); the copy is an inert visual: every part anchored, never
-- colliding, queried or touched. The template itself is never changed. Animations are not uploaded yet, so the model
-- moves in its rest pose.
-- Beast revision (odd/tasks/wildbound-beast-revision.md, owner 2026-11-16): the look of each revised beast, applied to
-- the adopted template (and to the proxy) once, in ReplicatedStorage, so every client draws the same size and colours.
--   scale   the model's size against its imported size (Model:ScaleTo; bones and attachments scale with it). The hit
--           volumes are WildboundBeastConfig's numbers, enlarged to match where the owner asked (Viper's lane).
--   colors  MeshPart name -> Color3 (FBX meshes import grey); material optional.
--   lights  bone name -> Color3: a faint PointLight on that bone (Gaze's eyes stay barely visible in the dark).
--   statue  Screamer's first form: every MeshPart in stone (material + colour), stored as attributes so the client can
--           switch to the true form (TrueColor/TrueMaterial) at the scream.
Proxies.LOOKS = table.freeze({
	Viper = table.freeze({ scale = 1.5 }),
	-- BR2: the tarantula template (assets/exports/caramelo/pouncer-tarantula.fbx) is built at its final size (7.2 tall,
	-- 14.7 across); its MeshParts import grey and take the build script's palette here.
	Pouncer = table.freeze({ scale = 1,
		colors = table.freeze({ Pouncer_Body = Color3.fromRGB(58, 42, 33), Pouncer_Abdomen = Color3.fromRGB(43, 31, 26),
			Pouncer_Legs = Color3.fromRGB(30, 22, 19), Pouncer_Bands = Color3.fromRGB(214, 110, 44),
			Pouncer_Hair = Color3.fromRGB(140, 86, 54), Pouncer_Eyes = Color3.fromRGB(255, 63, 192),
			Pouncer_Fangs = Color3.fromRGB(217, 200, 168) }),
		neon = table.freeze({ Pouncer_Eyes = true }) }),
	Streamer = table.freeze({ scale = 1.15,
		colors = table.freeze({ Streamer_Mesh = Color3.fromRGB(92, 40, 54) }), material = Enum.Material.SmoothPlastic,
		statue = table.freeze({ color = Color3.fromRGB(138, 136, 128), material = Enum.Material.Slate }) }),
	Root = table.freeze({ scale = 1.45,
		colors = table.freeze({ Root_Mesh = Color3.fromRGB(96, 64, 40) }), material = Enum.Material.Wood }),
	Gaze = table.freeze({ scale = 1.6,
		colors = table.freeze({ Gaze_Mesh = Color3.fromRGB(16, 14, 20) }), material = Enum.Material.SmoothPlastic,
		lights = table.freeze({ Eye_L = Color3.fromRGB(150, 30, 60), Eye_R = Color3.fromRGB(150, 30, 60) }) }),
})

-- Applies Proxies.LOOKS[beast] to a model (a clone, never a template). Idempotent through the "Dressed" attribute.
function Proxies.dress(model, beast)
	local look = Proxies.LOOKS[beast]
	if not look or typeof(model) ~= "Instance" or not model:IsA("Model") or model:GetAttribute("Dressed") then return model end
	if type(look.scale) == "number" and look.scale > 0 and math.abs(look.scale - 1) > 1e-3 then
		model:ScaleTo(model:GetScale() * look.scale)
	end
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("MeshPart") and look.colors and look.colors[d.Name] then
			d.Color = look.colors[d.Name]
			if look.material then d.Material = look.material end
			if look.neon and look.neon[d.Name] then d.Material = Enum.Material.Neon end
			if look.statue then
				d:SetAttribute("TrueColor", d.Color)
				d:SetAttribute("TrueMaterial", d.Material.Name)
				d:SetAttribute("StatueColor", look.statue.color)
				d:SetAttribute("StatueMaterial", look.statue.material.Name)
				d.Color, d.Material = look.statue.color, look.statue.material
			end
		elseif d:IsA("Bone") and look.lights and look.lights[d.Name] then
			local light = Instance.new("PointLight")
			light.Name = "EyeGlow"
			light.Color, light.Brightness, light.Range, light.Shadows = look.lights[d.Name], 1.2, 5, false
			light.Parent = d
		end
	end
	model:SetAttribute("Dressed", true)
	return model
end

function Proxies.adopt(template, beast)
	if typeof(template) ~= "Instance" or not template:IsA("Model") or type(beast) ~= "string" then return nil end
	local root = template:FindFirstChild("Root")
	if not (root and root:IsA("BasePart")) then return nil end
	local model = template:Clone()
	model.Name = beast
	model.PrimaryPart = model:FindFirstChild("Root")
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored, d.CanCollide, d.CanQuery, d.CanTouch, d.Massless = true, false, false, false, true
		elseif d:IsA("PackageLink") then
			d:Destroy()
		end
	end
	model:SetAttribute("Beast", beast)
	model:SetAttribute("Proxy", false)
	return Proxies.dress(model, beast)
end

-- Builds ReplicatedStorage.WildboundBeasts.Models and the missing proxies (always kept as the fallback), and adopts the
-- Viper and Pouncer templates when given. Never touches an existing model.
function Proxies.ensure(replicated, templates)
	local root = replicated:FindFirstChild("WildboundBeasts")
	if not root then
		root = Instance.new("Folder")
		root.Name = "WildboundBeasts"
		root.Parent = replicated
	end
	local models = root:FindFirstChild("Models")
	if not models then
		models = Instance.new("Folder")
		models.Name = "Models"
		models.Parent = root
	end
	for beast, build in pairs(Proxies.BUILDERS) do
		if not models:FindFirstChild(beast .. "Proxy") then
			local proxy = build()
			-- BR1-BR5: a proxy keeps its own colours, but takes the revised size.
			local look = Proxies.LOOKS[beast]
			if look and type(look.scale) == "number" and math.abs(look.scale - 1) > 1e-3 then proxy:ScaleTo(proxy:GetScale() * look.scale) end
			proxy.Parent = models
		end
		if typeof(templates) == "Instance" and not models:FindFirstChild(beast) then
			local real = Proxies.adopt(templates:FindFirstChild(beast), beast)
			if real then real.Parent = models end
		end
	end
	return models
end

return Proxies]]></ProtectedString></Properties></Item>
</Item></roblox>