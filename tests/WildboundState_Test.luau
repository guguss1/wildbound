-- Run with a freshly cloned State module to avoid Roblox require-cache reuse.
return function(State)
	local result = { passed = 0, failed = 0, messages = {} }
	local function case(name, run)
		local ok, message = pcall(run)
		if ok then
			result.passed += 1
		else
			result.failed += 1
			table.insert(result.messages, name .. ": " .. tostring(message))
		end
	end
	local function equal(actual, expected, message)
		assert(actual == expected, (message or "Unexpected value")
			.. ": expected " .. tostring(expected) .. ", got " .. tostring(actual))
	end
	local function accepted(ok, value)
		equal(ok, true, tostring(value))
		return value
	end
	local function rejected(ok)
		equal(ok, false, "Request must be rejected")
	end
	local function setup()
		local state = State.new()
		accepted(state:addPlayer("Alice"))
		accepted(state:addPlayer("Bob"))
		return state
	end
	local function collect(state, id, kind, player)
		kind = kind or "Creature"
		accepted(state:registerEncounter(id, kind))
		-- M3.3: a creature is granted only by a finished capture; eggs keep the 10 stud pickup.
		local uid = kind == "Creature" and accepted(state:completeCapture(player or "Alice", id, true, "Fog"))
			or accepted(state:pickup(player or "Alice", id, true, 10))
		assert(type(uid) == "string" and uid ~= "", "Pickup must return a UID")
		return uid
	end

	case("new session and repeat add do not reset inventory", function()
		local state = setup()
		local snapshot = state:snapshot("Alice")
		equal(snapshot.sessionOnly, true)
		equal(snapshot.capacity, 3)
		equal(#snapshot.pending, 0)
		equal(#snapshot.bankedEggs, 0)
		equal(#snapshot.registered, 0)
		equal(snapshot.sealCharges, 0)
		equal(snapshot.equippedUid, nil)
		collect(state, "creature")
		state:addPlayer("Alice")
		equal(#state:snapshot("Alice").pending, 1)
		equal(state:snapshot("Unknown"), nil)
	end)

	case("encounters are validated and cannot be redefined", function()
		local state = setup()
		rejected(state:registerEncounter(nil, "Creature"))
		rejected(state:registerEncounter("", "Creature"))
		rejected(state:registerEncounter("bad", "Other"))
		rejected(state:registerEncounter("bad", nil))
		accepted(state:registerEncounter("one", "Creature"))
		rejected(state:registerEncounter("one", "Egg"))
		accepted(state:completeCapture("Alice", "one", true, "Fog"))
		equal(state:snapshot("Alice").pending[1].kind, "Creature")
	end)

	case("shared world claim has exactly one winner", function()
		local state = setup()
		accepted(state:registerEncounter("shared", "Egg"))
		accepted(state:pickup("Alice", "shared", true, 10))
		rejected(state:pickup("Bob", "shared", true, 0))
		rejected(state:pickup("Alice", "shared", true, 0))
		equal(state:isClaimed("shared"), true)
		equal(#state:snapshot("Alice").pending, 1)
		equal(#state:snapshot("Bob").pending, 0)
		accepted(state:defeat("Alice", "death1"))
		rejected(state:pickup("Bob", "shared", true, 0))
	end)

	case("invalid pickup never claims or creates player state", function()
		local state = setup()
		accepted(state:registerEncounter("valid", "Creature"))
		for _, distance in ipairs({ -1, 10.01, math.huge, -math.huge, 0 / 0, "0", {} }) do
			rejected(state:pickup("Alice", "valid", true, distance))
		end
		rejected(state:pickup("Alice", "valid", true, nil))
		rejected(state:pickup("Alice", "valid", false, 0))
		rejected(state:pickup("Alice", "valid", 1, 0))
		rejected(state:pickup("Unknown", "valid", true, 0))
		rejected(state:pickup(nil, "valid", true, 0))
		rejected(state:pickup("Alice", nil, true, 0))
		rejected(state:pickup("Alice", {}, true, 0))
		rejected(state:pickup("Alice", "missing", true, 0))
		equal(state:isClaimed("valid"), false)
		equal(state:isClaimed(nil), false)
		equal(state:snapshot("Unknown"), nil)
	end)

	case("capacity rejects fourth item without reserving it", function()
		local state = setup()
		local ids = {}
		for index = 1, 3 do ids[index] = collect(state, "item" .. index) end
		assert(ids[1] ~= ids[2] and ids[2] ~= ids[3], "UIDs must be unique")
		accepted(state:registerEncounter("fourth", "Egg"))
		rejected(state:pickup("Alice", "fourth", true, 0))
		equal(state:isClaimed("fourth"), false)
		accepted(state:pickup("Bob", "fourth", true, 0))
		equal(#state:snapshot("Alice").pending, 3)
	end)

	case("extraction registers creatures but banks eggs", function()
		local state = setup()
		local creature = collect(state, "creature")
		local egg = collect(state, "egg", "Egg")
		local pending = state:snapshot("Alice").pending
		equal(pending[1].species, "Lumipol")
		equal(pending[1].protected, false)
		equal(pending[2].kind, "Egg")
		rejected(state:equip("Alice", creature, true))
		equal(accepted(state:extract("Alice", true, 12)), 2)
		local snapshot = state:snapshot("Alice")
		equal(#snapshot.pending, 0)
		equal(snapshot.registered[1].uid, creature)
		equal(snapshot.registered[1].species, "Lumipol")
		equal(snapshot.bankedEggs[1].uid, egg)
		equal(snapshot.sealCharges, 1)
		rejected(state:extract("Alice", true, 12))
		equal(#state:snapshot("Alice").registered, 1)
	end)

	case("invalid extraction is atomic", function()
		local state = setup()
		collect(state, "one")
		for _, distance in ipairs({ -1, 12.01, math.huge, 0 / 0, "0" }) do
			rejected(state:extract("Alice", true, distance))
		end
		rejected(state:extract("Alice", true, nil))
		rejected(state:extract("Alice", false, 0))
		rejected(state:extract("Alice", 1, 0))
		rejected(state:extract("Unknown", true, 0))
		equal(#state:snapshot("Alice").pending, 1)
		equal(state:snapshot("Alice").sealCharges, 0)
	end)

	case("hatch is free, camp-only, owned and exactly once", function()
		local state = setup()
		local egg = collect(state, "egg", "Egg")
		rejected(state:hatch("Alice", egg, true, 0))
		accepted(state:extract("Alice", true, 0))
		rejected(state:hatch("Bob", egg, true, 0))
		rejected(state:hatch("Alice", egg, false, 0))
		for _, distance in ipairs({ -1, 12.01, math.huge, 0 / 0, "0" }) do
			rejected(state:hatch("Alice", egg, true, distance))
		end
		rejected(state:hatch("Alice", nil, true, 0))
		rejected(state:hatch("Alice", egg, true, nil))
		local pet = accepted(state:hatch("Alice", egg, true, 12))
		rejected(state:hatch("Alice", egg, true, 0))
		local snapshot = state:snapshot("Alice")
		equal(#snapshot.bankedEggs, 0)
		equal(#snapshot.registered, 1)
		equal(snapshot.registered[1].uid, pet)
		equal(snapshot.registered[1].species, "Lumipol")
		equal(snapshot.sealCharges, 1)
	end)

	case("only a living owner can equip registered pets", function()
		local state = setup()
		local pet = collect(state, "pet")
		local egg = collect(state, "egg", "Egg")
		accepted(state:extract("Alice", true, 0))
		rejected(state:equip("Bob", pet, true))
		rejected(state:equip("Alice", egg, true))
		rejected(state:equip("Alice", pet, false))
		rejected(state:equip("Alice", pet, 1))
		rejected(state:equip("Alice", nil, true))
		accepted(state:equip("Alice", pet, true))
		accepted(state:equip("Alice", pet, true))
		equal(state:snapshot("Alice").equippedUid, pet)
	end)

	case("seal requires earned charge and one explicit owned pending item", function()
		local state = setup()
		local first = collect(state, "first")
		rejected(state:protect("Alice", first, true))
		accepted(state:extract("Alice", true, 0))
		local one = collect(state, "one")
		local two = collect(state, "two", "Egg")
		rejected(state:protect("Bob", one, true))
		rejected(state:protect("Alice", first, true))
		rejected(state:protect("Alice", nil, true))
		rejected(state:protect("Alice", one, false))
		rejected(state:protect("Alice", one, 1))
		accepted(state:protect("Alice", one, true))
		rejected(state:protect("Alice", two, true))
		state:protect("Alice", one, true)
		local snapshot = state:snapshot("Alice")
		equal(snapshot.pending[1].protected, true)
		equal(snapshot.pending[2].protected, false)
		equal(snapshot.sealCharges, 1)
	end)

	case("death preserves one sealed item and never banked or registered losses", function()
		local state = setup()
		local pet = collect(state, "pet")
		local banked = collect(state, "banked", "Egg")
		accepted(state:extract("Alice", true, 0))
		accepted(state:equip("Alice", pet, true))
		local survivor = collect(state, "survivor", "Egg")
		collect(state, "lost")
		accepted(state:protect("Alice", survivor, true))
		accepted(state:defeat("Alice", "death1"))
		local snapshot = state:snapshot("Alice")
		equal(#snapshot.pending, 1)
		equal(snapshot.pending[1].uid, survivor)
		equal(snapshot.pending[1].protected, false)
		equal(snapshot.sealCharges, 0)
		equal(snapshot.registered[1].uid, pet)
		equal(snapshot.bankedEggs[1].uid, banked)
		equal(snapshot.equippedUid, pet)
		collect(state, "new")
		state:defeat("Alice", "death1")
		equal(#state:snapshot("Alice").pending, 2)
		accepted(state:defeat("Alice", "death2"))
		equal(#state:snapshot("Alice").pending, 0)
	end)

	case("safe extraction does not consume seals and reward cannot farm", function()
		local state = setup()
		collect(state, "first")
		accepted(state:extract("Alice", true, 0))
		local second = collect(state, "second")
		accepted(state:protect("Alice", second, true))
		accepted(state:extract("Alice", true, 0))
		equal(state:snapshot("Alice").sealCharges, 1)
		local third = collect(state, "third")
		accepted(state:protect("Alice", third, true))
		accepted(state:defeat("Alice", "death"))
		accepted(state:extract("Alice", true, 0))
		equal(state:snapshot("Alice").sealCharges, 0)
	end)

	case("invalid keys and death operations reject without mutation", function()
		local state = setup()
		rejected(state:addPlayer(nil))
		rejected(state:addPlayer({}))
		rejected(state:addPlayer(""))
		rejected(state:addPlayer(0 / 0))
		accepted(state:addPlayer(123))
		collect(state, "one")
		rejected(state:defeat("Alice", nil))
		rejected(state:defeat("Alice", ""))
		rejected(state:defeat("Alice", {}))
		rejected(state:defeat("Unknown", "valid"))
		equal(#state:snapshot("Alice").pending, 1)
	end)

	case("snapshots are detached at every nested collection", function()
		local state = setup()
		local pet = collect(state, "pet")
		local egg = collect(state, "egg", "Egg")
		accepted(state:extract("Alice", true, 0))
		local pending = collect(state, "pending")
		local snapshot = state:snapshot("Alice")
		snapshot.pending[1].uid = "forged"
		snapshot.pending[1].protected = true
		snapshot.bankedEggs[1].uid = "forged"
		snapshot.registered[1].uid = "forged"
		snapshot.sealCharges = 99
		table.insert(snapshot.registered, { uid = "forged", species = "Lumipol" })
		local fresh = state:snapshot("Alice")
		equal(fresh.pending[1].uid, pending)
		equal(fresh.pending[1].protected, false)
		equal(fresh.bankedEggs[1].uid, egg)
		equal(fresh.registered[1].uid, pet)
		equal(#fresh.registered, 1)
		equal(fresh.sealCharges, 1)
		rejected(state:equip("Alice", "forged", true))
	end)

	case("collection cap is bounded and does not reserve overflow loot", function()
		local state = setup()
		for index = 1, 100 do
			collect(state, "bounded" .. index)
			accepted(state:extract("Alice", true, 0))
		end
		accepted(state:registerEncounter("overflow", "Egg"))
		rejected(state:pickup("Alice", "overflow", true, 0))
		equal(state:isClaimed("overflow"), false)
		equal(#state:snapshot("Alice").registered, 100)
		equal(state:snapshot("Alice").collectionLimit, 100)
		accepted(state:pickup("Bob", "overflow", true, 0))
	end)

	case("profile cleanup does not release shared world claims", function()
		local state = setup()
		collect(state, "claimed")
		accepted(state:removePlayer("Alice"))
		equal(state:snapshot("Alice"), nil)
		rejected(state:pickup("Bob", "claimed", true, 0))
		accepted(state:addPlayer("Alice"))
		equal(#state:snapshot("Alice").pending, 0)
		equal(state:isClaimed("claimed"), true)
	end)

	case("retired slot IDs are unknown while fresh slots remain collectable", function()
		local state = setup()
		collect(state, "old")
		accepted(state:retireEncounter("old"))
		rejected(state:pickup("Bob", "old", true, 0))
		accepted(state:registerEncounter("fresh", "Creature"))
		accepted(state:completeCapture("Bob", "fresh", true, "Fog"))
		rejected(state:registerEncounter(string.rep("x", 129), "Egg"))
		rejected(state:addPlayer(math.huge))
		rejected(state:addPlayer(1.5))
	end)

	-- M3.3: capture grants. The ring session decides skill; State only claims, grants and refuses.
	case("a creature cannot be picked up, and the refusal claims nothing (CAP-18)", function()
		local state = setup()
		accepted(state:registerEncounter("wild", "Creature"))
		for _, distance in ipairs({ 0, 5, 10 }) do
			local ok, reason = state:pickup("Alice", "wild", true, distance)
			equal(ok, false, "pickup of a creature")
			equal(reason, "CaptureRequired")
		end
		equal(state:isClaimed("wild"), false)
		equal(#state:snapshot("Alice").pending, 0)
		accepted(state:completeCapture("Alice", "wild", true, "Safe"))
	end)

	case("a finished capture grants once and records the risk tier (CAP-17)", function()
		local state = setup()
		accepted(state:registerEncounter("wild", "Creature"))
		local uid = accepted(state:completeCapture("Alice", "wild", true, "Territory"))
		local pending = state:snapshot("Alice").pending
		equal(#pending, 1)
		equal(pending[1].uid, uid)
		equal(pending[1].kind, "Creature")
		equal(pending[1].species, "Lumipol")
		equal(pending[1].protected, false)
		equal(pending[1].riskTier, "Territory")
		equal(state:isClaimed("wild"), true)
		local ok, reason = state:completeCapture("Alice", "wild", true, "Territory")
		equal(ok, false)
		equal(reason, "AlreadyClaimed")
		rejected(state:completeCapture("Bob", "wild", true, "Territory"))
		equal(#state:snapshot("Alice").pending, 1)
		equal(#state:snapshot("Bob").pending, 0)
	end)

	case("a capture grant needs a live player, a known creature and a known tier", function()
		local state = setup()
		accepted(state:registerEncounter("wild", "Creature"))
		accepted(state:registerEncounter("egg", "Egg"))
		local function refused(reason, ...)
			local ok, got = state:completeCapture(...)
			equal(ok, false, "grant must be refused")
			equal(got, reason)
		end
		refused("InvalidPlayer", "Nobody", "wild", true, "Fog")
		refused("InvalidPlayer", nil, "wild", true, "Fog")
		refused("InvalidEncounter", "Alice", nil, true, "Fog")
		refused("InvalidEncounter", "Alice", "", true, "Fog")
		refused("InvalidEncounter", "Alice", {}, true, "Fog")
		refused("InvalidEncounter", "Alice", "missing", true, "Fog")
		refused("InvalidEncounter", "Alice", "egg", true, "Fog")
		refused("InvalidContext", "Alice", "wild", false, "Fog")
		refused("InvalidContext", "Alice", "wild", 1, "Fog")
		refused("InvalidContext", "Alice", "wild", nil, "Fog")
		refused("InvalidTier", "Alice", "wild", true, "Moon")
		refused("InvalidTier", "Alice", "wild", true, nil)
		refused("InvalidTier", "Alice", "wild", true, {})
		equal(state:isClaimed("wild"), false)
		equal(#state:snapshot("Alice").pending, 0)
		accepted(state:completeCapture("Alice", "wild", true, "Fog"))
	end)

	case("a full bag or collection refuses a capture grant without claiming it", function()
		local state = setup()
		for index = 1, 3 do collect(state, "held" .. index, "Egg") end
		accepted(state:registerEncounter("wild", "Creature"))
		local ok, reason = state:completeCapture("Alice", "wild", true, "Fog")
		equal(ok, false)
		equal(reason, "BackpackFull")
		equal(state:isClaimed("wild"), false)
		accepted(state:completeCapture("Bob", "wild", true, "Fog"))
		local crowded = State.new()
		accepted(crowded:addPlayer("Carol"))
		for index = 1, 100 do
			local id = "bank" .. index
			accepted(crowded:registerEncounter(id, "Egg"))
			accepted(crowded:pickup("Carol", id, true, 0))
			if index % 3 == 0 then accepted(crowded:extract("Carol", true, 0)) end
		end
		accepted(crowded:registerEncounter("late", "Creature"))
		local full, why = crowded:completeCapture("Carol", "late", true, "Fog")
		equal(full, false)
		assert(why == "CollectionFull" or why == "BackpackFull", "unexpected reason " .. tostring(why))
		equal(crowded:isClaimed("late"), false)
	end)

	case("a retired creature cannot be granted, and a captured one extracts as a pet", function()
		local state = setup()
		accepted(state:registerEncounter("gone", "Creature"))
		accepted(state:retireEncounter("gone"))
		rejected(state:completeCapture("Alice", "gone", true, "Fog"))
		local uid = collect(state, "wild")
		accepted(state:extract("Alice", true, 0))
		local snapshot = state:snapshot("Alice")
		equal(#snapshot.pending, 0)
		equal(snapshot.registered[1].uid, uid)
		equal(snapshot.registered[1].species, "Lumipol")
	end)

	case("a captured creature is lost on defeat unless protected, like any pending item", function()
		local state = setup()
		collect(state, "wild")
		accepted(state:defeat("Alice", "life:1"))
		equal(#state:snapshot("Alice").pending, 0)
	end)

	case("encounterStatus reports open, claimed and unknown", function()
		local state = setup()
		equal(state:encounterStatus("wild"), nil)
		accepted(state:registerEncounter("wild", "Creature"))
		equal(state:encounterStatus("wild"), "Open")
		accepted(state:completeCapture("Alice", "wild", true, "Fog"))
		equal(state:encounterStatus("wild"), "Claimed")
		accepted(state:retireEncounter("wild"))
		equal(state:encounterStatus("wild"), nil)
		equal(state:encounterStatus(nil), nil)
		equal(state:encounterStatus({}), nil)
		equal(state:encounterStatus(string.rep("x", 129)), nil)
	end)

	case("captureRoom reports bag and collection room from private state", function()
		local state = setup()
		local bag, collection = state:captureRoom("Alice")
		equal(bag, true)
		equal(collection, true)
		for index = 1, 3 do collect(state, "item" .. index) end
		bag, collection = state:captureRoom("Alice")
		equal(bag, false)
		equal(collection, true)
		bag, collection = state:captureRoom("Nobody")
		equal(bag, false)
		equal(collection, false)
		bag, collection = state:captureRoom(nil)
		equal(bag, false)
		equal(collection, false)
	end)

	-- Staged strike, D6 (docs/mechanics/wildbound-fair-strike.md, FS-40 to FS-45).
	local function pendingUids(state, key)
		local uids = {}
		for _, entry in ipairs(state:snapshot(key).pending) do table.insert(uids, entry.uid) end
		return table.concat(uids, ",")
	end
	case("FS-40 the first strike drops the newest unprotected pending item, or marks only", function()
		local state = setup()
		local ok, dropped = state:dropForStrike("Alice", "atk:1")
		equal(ok, true); equal(dropped, nil, "empty bag: mark only")
		local only = collect(state, "egg1", "Egg")
		ok, dropped = state:dropForStrike("Alice", "atk:2")
		equal(ok, true); equal(dropped.uid, only); equal(dropped.kind, "Egg")
		equal(#state:snapshot("Alice").pending, 0); equal(#state:snapshot("Alice").dropped, 1)
		local a, b, c = collect(state, "c1"), collect(state, "c2"), collect(state, "egg2", "Egg")
		ok, dropped = state:dropForStrike("Alice", "atk:3")
		equal(dropped.uid, c, "newest drops"); equal(pendingUids(state, "Alice"), a .. "," .. b)
	end)
	case("FS-40 a protected item never drops", function()
		local state = setup()
		local first = collect(state, "c1")
		accepted(state:extract("Alice", true, 0)) -- earns the seal
		local kept = collect(state, "c2")
		accepted(state:protect("Alice", kept, true))
		local ok, dropped = state:dropForStrike("Alice", "atk:1")
		equal(ok, true); equal(dropped, nil, "only a protected item: mark only")
		equal(pendingUids(state, "Alice"), kept)
		local loose = collect(state, "egg1", "Egg")
		ok, dropped = state:dropForStrike("Alice", "atk:2")
		equal(dropped.uid, loose)
		assert(first ~= kept)
	end)
	case("FS-41 the same attack never drops twice, and bad ids or players are refused", function()
		local state = setup()
		collect(state, "c1"); collect(state, "c2")
		local _, dropped = state:dropForStrike("Alice", "atk:1")
		assert(dropped, "first drop")
		local ok, again = state:dropForStrike("Alice", "atk:1")
		equal(ok, true); equal(again, nil)
		equal(#state:snapshot("Alice").pending, 1); equal(#state:snapshot("Alice").dropped, 1)
		rejected(state:dropForStrike("Alice", nil))
		rejected(state:dropForStrike("Alice", ""))
		rejected(state:dropForStrike("Nobody", "atk:2"))
	end)
	case("FS-43 only the owner reclaims a dropped item, within reach and with bag room", function()
		local state = setup()
		collect(state, "c1")
		local _, dropped = state:dropForStrike("Alice", "atk:1")
		local refused, reason = state:reclaimDropped("Bob", dropped.uid, true, 2)
		equal(refused, false); equal(reason, "NotOwnedDropped")
		refused, reason = state:reclaimDropped("Alice", dropped.uid, true, 10.5)
		equal(refused, false); equal(reason, "InvalidContext")
		for index = 1, 3 do collect(state, "full" .. index) end
		refused, reason = state:reclaimDropped("Alice", dropped.uid, true, 2)
		equal(refused, false); equal(reason, "BackpackFull")
		equal(#state:snapshot("Alice").dropped, 1, "stays on the ground")
		state:extract("Alice", true, 0)
		local ok, uid = state:reclaimDropped("Alice", dropped.uid, true, 2)
		equal(ok, true); equal(uid, dropped.uid)
		equal(pendingUids(state, "Alice"), dropped.uid); equal(#state:snapshot("Alice").dropped, 0)
		rejected(state:reclaimDropped("Alice", dropped.uid, true, 2))
	end)
	case("FS-43 an expired drop is lost once", function()
		local state = setup()
		collect(state, "c1")
		local _, dropped = state:dropForStrike("Alice", "atk:1")
		local ok, lost = state:loseDropped("Alice", dropped.uid)
		equal(ok, true); equal(lost.uid, dropped.uid)
		rejected(state:loseDropped("Alice", dropped.uid))
		equal(#state:snapshot("Alice").dropped, 0)
	end)
	case("FS-43 and FS-45 defeat loses dropped and pending items, keeps banked and registered, and summarizes", function()
		local state = setup()
		collect(state, "c0")
		accepted(state:extract("Alice", true, 0)) -- one registered, one seal
		local banked = collect(state, "eggBank", "Egg")
		accepted(state:extract("Alice", true, 0))
		local saved = collect(state, "c1")
		accepted(state:protect("Alice", saved, true))
		local loose = collect(state, "egg1", "Egg")
		local onGround = collect(state, "c2")
		local _, dropped = state:dropForStrike("Alice", "atk:1")
		equal(dropped.uid, onGround)
		local ok, lostCount, summary = state:defeat("Alice", "life:3")
		equal(ok, true); equal(lostCount, 2)
		equal(summary.operationId, "life:3")
		equal(#summary.lostItems, 2)
		local lost = {}
		for _, item in ipairs(summary.lostItems) do lost[item.uid] = item end
		assert(lost[loose] and lost[onGround], "both the bag item and the dropped item are listed")
		equal(lost[loose].kind, "Egg"); equal(lost[loose].species, "Lumipol")
		equal(summary.savedItem.uid, saved)
		equal(summary.kept.registered, 1); equal(summary.kept.bankedEggs, 1)
		equal(summary.kept.ember, 0); equal(summary.kept.bankedMaterials, 0)
		equal(next(summary.materialsLost), nil)
		local snapshot = state:snapshot("Alice")
		equal(#snapshot.dropped, 0); equal(#snapshot.registered, 1); equal(snapshot.bankedEggs[1].uid, banked)
		local again, count, repeatSummary = state:defeat("Alice", "life:3")
		equal(again, true); equal(count, 0); equal(repeatSummary, nil)
	end)
	case("a defeat summary is detached from private state", function()
		local state = setup()
		collect(state, "c1")
		local _, _, summary = state:defeat("Alice", "life:1")
		summary.lostItems[1].uid = "changed"
		summary.kept.registered = 99
		local _, _, second = state:defeat("Alice", "life:2")
		equal(#second.lostItems, 0); equal(second.kept.registered, 0)
	end)

	return result
end
