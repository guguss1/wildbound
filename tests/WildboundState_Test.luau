		local second = carry(state)
		local _, _, later = state:register("Alice", second, true, 0)
		equal(later.isNew, false, "the collection entry unlocks once")
	end)

	case("B1 registration ends the trip once: base Ember and the first seal, and the chest pays no second base", function()
		local state = setup()
		accepted(state:observeExpedition("Alice", 70, true, 100))
		gathered(state, "Alice", "fogbark", 2, 110)
		local uid = carry(state, "Alice", "Territory")
		local _, _, receipt = state:register("Alice", uid, true, 0, 150)
		equal(receipt.ember, 18, "Territory 14 plus the base 4"); equal(receipt.baseEmber, 4)
		equal(snap(state).expedition, nil); equal(snap(state).consumables.seal, 1)
		local _, count, chest = state:extract("Alice", true, 0, 151)
		equal(count, 0); equal(chest.baseEmber, 0, "the trip already ended"); equal(chest.units.fogbark, 2)
		equal(snap(state).ember, 18); equal(snap(state).banked.fogbark, 2)
	end)

	case("B1 a defeat loses the carried creature unless warded, and never a registered one", function()
		local state = setup()
		local pet = bring(state)
		accepted(state:equip("Alice", pet, true))
		local lost = carry(state, "Alice", "Territory")
		equal(snap(state).riskPreview.loseItems, 1)
		local _, count, summary = state:defeat("Alice", "life:1")
		equal(count, 1); equal(summary.lostItems[1].uid, lost); equal(summary.lostItems[1].kind, "Creature")
		local snapshot = snap(state)
		equal(snapshot.carrying, nil); equal(#snapshot.registered, 1); equal(snapshot.registered[1].uid, pet)
		equal(snapshot.equippedUid, pet); equal(summary.kept.registered, 1)
		local saved = carry(state)
		accepted(state:protect("Alice", saved, true))
		equal(snap(state).carrying.protected, true); equal(snap(state).carrying.wardSource, "Seal")
		equal(snap(state).riskPreview.loseItems, 0); equal(snap(state).riskPreview.keep, 1)
		local _, none, kept = state:defeat("Alice", "life:2")
		equal(none, 0); equal(kept.savedItem.uid, saved)
		equal(snap(state).carrying.uid, saved); equal(snap(state).carrying.protected, false)
		equal(snap(state).consumables.seal, 0, "spent because it saved")
		for life = 3, 6 do accepted(state:defeat("Alice", "life:" .. life)) end
		equal(snap(state).carrying, nil)
		equal(#snap(state).registered, 1, "registered companions are never lost"); equal(snap(state).equippedUid, pet)
	end)

	case("B1 an armed seal wards the carried creature, and SealNewest picks it before bag items", function()
		local state = setup()
		bring(state)
		accepted(state:armSeal("Alice", true))
		carry(state)
		equal(snap(state).carrying.wardSource, "Seal"); equal(snap(state).sealArmed, false)
		local fresh = setup()
		gathered(fresh, "Alice", "fogbark", 1)
		accepted(fresh:extract("Alice", true, 0))
		collect(fresh, "egg", "Egg")
		local carried = carry(fresh)
		equal(accepted(fresh:sealNewest("Alice", true)), carried)
		equal(snap(fresh).pending[1].protected, false)
		refusedWith("AlreadyProtected", fresh:sealNewest("Alice", true))
	end)

	-- Expedition islands (I5, K2): a cria stolen from an island nest keeps its species, stage and island to the refuge,
	-- an egg from a nest keeps the tier and species of its island, and the first cria registered pays the bonus once.
	case("I5: species and stage survive register", function()
		local state = setup()
		accepted(state:registerEncounter("nest:I2", "Creature"))
		local uid = accepted(state:completeCapture("Alice", "nest:I2", true, "Fog",
			{ species = "Cortezon", island = "I2" }))
		local carried = snap(state).carrying
		equal(carried.species, "Cortezon"); equal(carried.stage, "Cria"); equal(carried.island, "I2")
		equal(carried.riskTier, "Fog")
		local _, _, receipt = state:register("Alice", uid, true, 0)
		equal(receipt.species, "Cortezon"); equal(receipt.isNew, true)
		local snapshot = snap(state)
		equal(snapshot.registered[1].species, "Cortezon"); equal(snapshot.registered[1].stage, "Cria")
		equal(snapshot.discovered.Cortezon, true)
		accepted(state:registerEncounter("nest:x", "Creature"))
		refusedWith("InvalidSpecies", state:completeCapture("Alice", "nest:x", true, "Fog", { species = 7 }))
	end)

	case("I5: an egg from an island nest keeps its tier and species", function()
		local state = setup()
		accepted(state:registerEncounter("nest:I5", "Egg"))
		local uid = accepted(state:pickup("Alice", "nest:I5", true, 10, { species = "Tizoncillo", tier = "Heart",
			island = "I5" }))
		local egg = snap(state).pending[1]
		equal(egg.uid, uid); equal(egg.species, "Tizoncillo"); equal(egg.riskTier, "Heart"); equal(egg.island, "I5")
		accepted(state:registerEncounter("nest:old", "Egg"))
		accepted(state:pickup("Alice", "nest:old", true, 10))
		equal(snap(state).pending[2].riskTier, "Territory", "no island keeps the old Territory egg")
		accepted(state:registerEncounter("nest:bad", "Egg"))
		refusedWith("InvalidTier", state:pickup("Alice", "nest:bad", true, 10, { species = "Polvilla", tier = "Moon" }))
	end)

	case("I5: the island tiers are accepted for a cria", function()
		local state = setup()
		for _, tier in ipairs({ "Safe", "Fog", "FogFar", "Territory", "Heart" }) do
			local id = "tier:" .. tier
			accepted(state:registerEncounter(id, "Creature"))
			local uid = accepted(state:completeCapture("Alice", id, true, tier, { species = "Lumipol", island = "I1" }))
			accepted(state:releaseCarried("Alice"))
			assert(uid, tier)
		end
	end)

	case("K2: the first cria registered pays the first-steal bonus once", function()
		local state = setup()
		accepted(state:registerEncounter("nest:I1", "Creature"))
		local uid = accepted(state:completeCapture("Alice", "nest:I1", true, "Safe", { species = "Lumipol", island = "I1" }))
		local _, _, receipt = state:register("Alice", uid, true, 0)
		equal(receipt.firstBonus, 4); equal(receipt.ember, 6 + 4); equal(snap(state).ember, 10)
		equal(receipt.firstEver, true, "the very first creature")
		local _, _, again = state:register("Alice", uid, true, 0)
		equal(again.repeated, true); equal(again.ember, 0); equal(snap(state).ember, 10)
		accepted(state:registerEncounter("nest:I1b", "Creature"))
		local second = accepted(state:completeCapture("Alice", "nest:I1b", true, "Safe", { species = "Lumipol", island = "I1" }))
		local _, _, next = state:register("Alice", second, true, 0)
		equal(next.firstBonus, 0); equal(next.ember, 6); equal(snap(state).ember, 16)
		equal(next.firstEver, false)
		local other = setup()
		bring(other)
		equal(snap(other).ember, 10, "a creature with no island pays no bonus")
	end)

	-- Next batch NB4 (delivery E, docs/mechanics/wildbound-incubator.md): a banked egg goes into the incubator and hatches
	-- on the server's clock into a registered creature, exactly once.
	local function banked(state, id)
		local egg = collect(state, id or "egg", "Egg")
		accepted(state:extract("Alice", true, 0))
		return egg
	end
	case("NB4: incubate needs an owned banked egg, life, the incubator in reach and a free slot", function()
		local state = setup()
		assert(type(state.incubate) == "function", "State:incubate missing")
		local egg = collect(state, "egg", "Egg")
		rejected(state:incubate("Alice", egg, true, 0, 100, 90, 1)) -- still in the bag
		accepted(state:extract("Alice", true, 0))
		rejected(state:incubate("Bob", egg, true, 0, 100, 90, 1))
		rejected(state:incubate("Alice", egg, false, 0, 100, 90, 1))
		for _, distance in ipairs({ -1, 12.01, math.huge, 0 / 0, "0" }) do
			rejected(state:incubate("Alice", egg, true, distance, 100, 90, 1))
		end
		for _, bad in ipairs({ { 0 / 0, 90 }, { 100, 0 }, { 100, -5 }, { 100, 0 / 0 }, { "100", 90 } }) do
			rejected(state:incubate("Alice", egg, true, 0, bad[1], bad[2], 1))
		end
		local entry = accepted(state:incubate("Alice", egg, true, 12, 100, 90, 1))
		equal(entry.uid, egg); equal(entry.species, "Lumipol"); equal(entry.readyAt, 190); equal(entry.startedAt, 100)
		local snapshot = state:snapshot("Alice")
		equal(#snapshot.bankedEggs, 0, "the egg left the banked list")
		equal(#snapshot.incubating, 1, "and sits in the incubator")
		equal(snapshot.incubating[1].readyAt, 190)
		local second = banked(state, "egg2")
		local ok, reason = state:incubate("Alice", second, true, 0, 101, 90, 1)
		equal(ok, false); equal(reason, "IncubatorFull")
		equal(#state:snapshot("Alice").bankedEggs, 1, "a refused egg stays banked")
	end)
	case("NB4: a ready egg hatches once into a registered creature of its species; early or twice does nothing", function()
		local state = setup()
		local egg = banked(state)
		accepted(state:incubate("Alice", egg, true, 0, 100, 90, 1))
		local emberBefore = state:snapshot("Alice").ember
		equal(#state:hatchReady("Alice", 189.9), 0, "not before its time")
		equal(#state:snapshot("Alice").registered, 0)
		local hatched = state:hatchReady("Alice", 190)
		equal(#hatched, 1)
		equal(hatched[1].species, "Lumipol"); equal(hatched[1].egg, egg)
		assert(type(hatched[1].uid) == "string" and hatched[1].uid ~= egg, "a new creature uid")
		equal(#state:hatchReady("Alice", 500), 0, "exactly once")
		local snapshot = state:snapshot("Alice")
		equal(#snapshot.incubating, 0); equal(#snapshot.registered, 1); equal(snapshot.registered[1].uid, hatched[1].uid)
		equal(snapshot.discovered.Lumipol, true)
		equal(snapshot.ember, emberBefore, "hatching pays nothing (the chest paid the egg's Ember)")
		equal(#state:hatchReady("Nobody", 500), 0, "an unknown player hatches nothing")
		equal(#state:hatchReady("Alice", 0 / 0), 0, "a bad clock hatches nothing")
	end)
	-- Nest Heist Phase 3 (NS3): a hatch with no companion out makes the newborn the companion; one already out stays.
	case("NS3: a hatch equips the newborn only when no companion is equipped", function()
		local state = setup()
		local first = banked(state, "egg-a")
		accepted(state:incubate("Alice", first, true, 0, 100, 90, 1))
		local born = state:hatchReady("Alice", 190)
		equal(born[1].equipped, true, "the first hatch becomes the companion")
		equal(state:snapshot("Alice").equippedUid, born[1].uid)
		local second = banked(state, "egg-b")
		accepted(state:incubate("Alice", second, true, 0, 200, 90, 1))
		local later = state:hatchReady("Alice", 290)
		equal(later[1].equipped, false, "a companion already out stays")
		equal(state:snapshot("Alice").equippedUid, born[1].uid)
	end)

	case("NS4: the companion can be stored and another one equipped", function()
		local state = setup()
		rejected(state:unequip("Alice", true))
		local first = banked(state, "egg-c")
		accepted(state:incubate("Alice", first, true, 0, 100, 90, 1))
		local born = state:hatchReady("Alice", 190)
		rejected(state:unequip("Alice", false))
		accepted(state:unequip("Alice", true))
		equal(state:snapshot("Alice").equippedUid, nil, "stored")
		equal(#state:snapshot("Alice").registered, 1, "still in the collection")
		accepted(state:equip("Alice", born[1].uid, true))
		equal(state:snapshot("Alice").equippedUid, born[1].uid, "out again")
	end)

	-- Nest Heist Phase 3 (NS6): Esencia (Ember inside) is the only currency. A delivery pays each egg by its tier plus
	-- the trip's base, as the economy document says; incubating and hatching pay nothing; nothing else is a currency.
	case("NS6: a delivery pays the egg's tier and the trip base; a hatch pays nothing; Ember is the only currency", function()
		local state = setup()
		accepted(state:registerEncounter("egg-fog", "Egg"))
		accepted(state:pickup("Alice", "egg-fog", true, 5, { species = "Lumipol", tier = "Fog", arms = true }))
		local before = state:snapshot("Alice").ember
		local ok, count, receipt = state:extract("Alice", true, 0, 0)
		equal(ok, true); equal(count, 1)
		equal(receipt.ember, Config.earn.eggEmberByTier.Fog + receipt.baseEmber, "tier pay plus the base")
		equal(state:snapshot("Alice").ember - before, receipt.ember, "exactly what the receipt says")
		local egg = state:snapshot("Alice").bankedEggs[1].uid
		local banked = state:snapshot("Alice").ember
		accepted(state:incubate("Alice", egg, true, 0, 100, 90, 1))
		state:hatchReady("Alice", 200)
		equal(state:snapshot("Alice").ember, banked, "incubating and hatching are free and pay nothing")
		local snapshot = state:snapshot("Alice")
		for _, name in ipairs({ "coins", "gems", "robux", "tokens", "money" }) do
			equal(snapshot[name], nil, "no second currency: " .. name)
			equal(Config[name], nil, "no second currency in the tuning: " .. name)
		end
	end)

	case("NB4: an incubating egg survives a defeat and counts toward the collection limit", function()
		local state = setup()
		local egg = banked(state)
		accepted(state:incubate("Alice", egg, true, 0, 100, 90, 1))
		state:defeat("Alice", "op-1")
		equal(#state:snapshot("Alice").incubating, 1, "camp is safe")
		local before = 0
		for _ = 1, Config.capacity.collectionLimit do
			local ok = state:registerEncounter("fill:" .. before, "Egg")
			if not ok then break end
			local picked = state:pickup("Alice", "fill:" .. before, true, 10)
			before += 1
			if not picked then break end
			state:extract("Alice", true, 0)
		end
		local snapshot = state:snapshot("Alice")
		equal(#snapshot.bankedEggs + #snapshot.incubating + #snapshot.registered, Config.capacity.collectionLimit,
			"the incubating egg takes one place in the limit")
	end)

	return result
end
