	-- M5.5 protections and sinks (B8). Stock a profile through real gathers, captures and extractions.
	local captures = 0
	local function captured(state, key, tier)
		captures += 1
		local id = "cap" .. captures
		accepted(state:registerEncounter(id, "Creature"))
		return accepted(state:completeCapture(key, id, true, tier or "Territory"))
	end
	local function stock(state, key, fogbark, glowmoss, nightbloom, territoryCreatures)
		local function pouch(material, amount)
			while amount > 0 do
				local take = math.min(3, amount)
				gathered(state, key, material, take)
				amount -= take
				local s = state:snapshot(key)
				if s.carried.fogbark + s.carried.glowmoss + 3 > s.pouchCapacity then accepted(state:extract(key, true, 0)) end
			end
		end
		local function bagged(add)
			add()
			local s = state:snapshot(key)
			if #s.pending >= s.capacity then accepted(state:extract(key, true, 0)) end
		end
		pouch("fogbark", fogbark or 0); pouch("glowmoss", glowmoss or 0)
		for _ = 1, nightbloom or 0 do bagged(function() gathered(state, key, "nightbloom", 1) end) end
		for _ = 1, territoryCreatures or 0 do bagged(function() captured(state, key) end) end
		state:extract(key, true, 0)
	end
	local function refusedWith(expected, ok, reason)
		equal(ok, false, "must be refused"); equal(reason, expected)
	end

