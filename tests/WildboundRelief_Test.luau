-- Invoke with require(freshTestClone)(require(freshReliefClone), require(freshLayoutClone), freshReliefClone.Source).
-- Task R2 (docs/mechanics/wildbound-expedition-islands.md section 1): the one height rule, written in Python in
-- tools/plan_relief.py and here in Luau. The layout module is ServerStorage.WildboundReliefLayout, generated by
-- tools/export_relief_luau.py from assets/maps/forest-layout/relief-v1.json.
return function(Relief, layout, source)
	local result = { passed = 0, failed = 0, messages = {} }
	local function case(name, run)
		local ok, message = pcall(run)
		if ok then result.passed += 1 else
			result.failed += 1
			table.insert(result.messages, name .. ": " .. tostring(message))
		end
	end
	local function near(actual, expected, tolerance, label)
		assert(type(actual) == "number" and math.abs(actual - expected) <= tolerance,
			(label or "") .. " expected " .. tostring(expected) .. ", got " .. tostring(actual))
	end
	local function segment(ax, az, bx, bz, height)
		return { id = "T", feature = "test", ax = ax, az = az, bx = bx, bz = bz, height = height, crestWidth = 2,
			slopeDeg = 20 }
	end

	case("R2: the layout carries segments, 64 samples and the removed trees", function()
		assert(type(layout) == "table" and type(layout.segments) == "table" and #layout.segments > 0, "segments")
		assert(#layout.samples == 64, "64 samples, got " .. tostring(#layout.samples))
		assert(type(layout.removedTrees) == "table", "removedTrees")
		near(layout.floorTop, 0.5, 1e-9, "floor top")
		assert(#layout.segments * 9 <= 250, "part budget")
	end)

	case("R2: heightAt matches the planner's 64 golden samples within 0.01", function()
		local relief = Relief.new(layout)
		for index, sample in ipairs(layout.samples) do
			near(relief:heightAt(sample.x, sample.z), sample.y, 0.01, "sample " .. index)
		end
	end)

	case("R2: outside every segment is the floor top 0.5", function()
		local relief = Relief.new(layout)
		near(relief:heightAt(-140, 150), 0.5, 1e-9, "spawn")
		near(relief:heightAt(0, -85), 0.5, 1e-9, "guardian home")
		near(relief:heightAt(190, 190), 0.5, 1e-9, "far corner")
		near(Relief.new({ segments = {} }):heightAt(10, 10), 0.5, 1e-9, "empty layout")
		near(Relief.new(nil):heightAt(10, 10), 0.5, 1e-9, "no layout")
		near(Relief.FLOOR_TOP, 0.5, 1e-9, "constant")
	end)

	case("R2: a segment's crest, flank and tapered end follow the trapezoid", function()
		local relief = Relief.new({ segments = { segment(0, 0, 20, 0, 4) } })
		local run = 4 / math.tan(math.rad(20))
		near(relief:heightAt(10, 0), 4.5, 1e-6, "crest")
		near(relief:heightAt(10, 1 + run / 2), 2.5, 1e-6, "mid flank")
		near(relief:heightAt(20 + run / 2, 0), 2.5, 1e-6, "mid end cap")
		near(relief:heightAt(20 + run / 2, 1 + run / 4), 2.5, 1e-6, "corner takes the lower ramp")
		near(relief:heightAt(10, 1 + run + 0.01), 0.5, 1e-9, "beyond the toe")
	end)

	case("R2: overlapping segments take the maximum", function()
		local low = segment(0, 0, 40, 0, 2)
		local high = segment(10, -10, 10, 10, 6)
		local relief = Relief.new({ segments = { low, high } })
		near(relief:heightAt(10, 0), 6.5, 1e-6, "the higher crest wins")
		near(relief:heightAt(35, 0), 2.5, 1e-6, "the low crest away from the high one")
		local single = Relief.new({ segments = { high } })
		near(relief:heightAt(10, 12), single:heightAt(10, 12), 1e-9, "the high one alone where it dominates")
	end)

	case("R2: no sample is steeper than 20 degrees", function()
		local relief = Relief.new(layout)
		for _, sample in ipairs(layout.samples) do
			assert(relief:slopeAt(sample.x, sample.z) <= 20 + 1e-6, "sample too steep")
		end
		for _, seg in ipairs(layout.segments) do
			local mx, mz = (seg.ax + seg.bx) / 2, (seg.az + seg.bz) / 2
			for dx = -20, 20, 2.5 do
				for dz = -20, 20, 2.5 do
					local slope = relief:slopeAt(mx + dx, mz + dz)
					assert(slope >= 0 and slope <= 20 + 1e-6, ("%s at %.1f, %.1f is %.2f"):format(seg.id, dx, dz, slope))
				end
			end
		end
		local flat = Relief.new({ segments = { segment(0, 0, 20, 0, 4) } })
		near(flat:slopeAt(10, 0), 0, 1e-6, "crest is flat")
		near(flat:slopeAt(10, 1 + 4 / math.tan(math.rad(20)) / 2), 20, 0.01, "flank is the segment's slope")
	end)

	case("R2: NaN, nil and huge input return 0.5", function()
		local relief = Relief.new(layout)
		local nan = 0 / 0
		for _, input in ipairs({ { nan, 0 }, { 0, nan }, { math.huge, 0 }, { 0, -math.huge }, { 1e12, 1e12 } }) do
			near(relief:heightAt(input[1], input[2]), 0.5, 1e-9, "bad input")
			near(relief:slopeAt(input[1], input[2]), 0, 1e-9, "bad input slope")
		end
		near(relief:heightAt(nil, 3), 0.5, 1e-9, "nil x")
		near(relief:heightAt("a", 3), 0.5, 1e-9, "string x")
		local broken = Relief.new({ segments = { { ax = 0, az = 0, bx = 0, bz = 0, height = 3, crestWidth = 2,
			slopeDeg = 20 }, { ax = "x" }, segment(0, 0, 10, 0, -3), segment(0, 0, 10, 0, 0 / 0) } })
		near(broken:heightAt(0, 0), 0.5, 1e-9, "degenerate and malformed segments are ignored")
	end)

	case("R2: the rule is pure", function()
		assert(type(source) == "string" and #source > 0, "source")
		assert(not source:find("require%("), "no require")
		assert(not source:find("game[%.:]"), "no game access")
		assert(not source:find("workspace"), "no workspace")
	end)

	return result
end
