	case("UR-K1: glossy tones: seven named variants plus dark; glossColor falls back to the kit, the palette, then grey", function()
		assert(type(Style.GLOSS_TONES) == "table" and table.isfrozen(Style.GLOSS_TONES), "GLOSS_TONES frozen")
		for _, tone in ipairs({ "green", "red", "blue", "orange", "purple", "yellow", "grey", "dark" }) do
			assert(typeof(Style.GLOSS_TONES[tone]) == "Color3", "tone " .. tone)
			equal(Style.glossColor(tone), Style.GLOSS_TONES[tone], "glossColor " .. tone)
		end
		local t = Style.GLOSS_TONES
		assert(t.green.G > t.green.R and t.green.G > t.green.B, "green is green")
		assert(t.red.R > t.red.G and t.red.R > t.red.B, "red is red")
		assert(t.blue.B > t.blue.R and t.blue.B > t.blue.G, "blue is blue")
		assert(t.orange.R > t.orange.G and t.orange.G > t.orange.B, "orange is orange")
		assert(t.purple.B > t.purple.G and t.purple.R > t.purple.G, "purple is purple")
		assert(t.yellow.R > t.yellow.B and t.yellow.G > t.yellow.B and t.yellow.G > 0.6, "yellow is yellow")
		assert(math.abs(t.grey.R - t.grey.B) < 0.2, "grey is greyish")
		equal(Style.glossColor("close"), Style.KIT_COLORS.close, "a kit colour name")
		equal(Style.glossColor("slate"), Style.COLORS.slate, "a palette name")
		equal(Style.glossColor("nope"), t.grey, "unknown is grey")
		equal(Style.glossColor(nil), t.grey, "nil is grey")
		local custom = Color3.fromRGB(1, 2, 3)
		equal(Style.glossColor(custom), custom, "a Color3 is kept")
	end)

	case("UR-K2: HUD sizes: frozen, tap targets at least 44, a thick border, a small lip; the emoji list is frozen", function()
		local hud = Style.HUD_SIZES
		assert(type(hud) == "table" and table.isfrozen(hud), "HUD_SIZES frozen")
		assert(hud.iconButton >= 44, "icon button tap target")
		assert(hud.glossHeight >= 44, "glossy button height")
		assert(hud.counterHeight >= 44, "counter readable")
		assert(hud.barHeight >= 20, "bar readable")
		assert(hud.glossStroke >= 3 and hud.barStroke >= 3 and hud.panelStroke >= 4, "thick borders")
		assert(hud.lip >= 3 and hud.lip <= 8, "the 3D lip is a few pixels")
		assert(hud.captionText >= 14 and hud.barText >= 14 and hud.toastText >= 16, "readable words")
		assert(hud.bumpScale > 1 and hud.bumpScale <= 1.2, "a gentle pop")
		assert(type(Style.ICONS) == "table" and table.isfrozen(Style.ICONS), "ICONS frozen")
		for _, key in ipairs({ "gold", "bat", "dodge", "light", "pulse", "run", "heart" }) do
			assert(type(Style.ICONS[key]) == "string" and #Style.ICONS[key] > 0, "icon " .. key)
		end
	end)

	case("UR-K3: glossSequence: a lit top half, a darker lower half, a dark lip of lip/height at the bottom", function()
		local sequence = Style.glossSequence(52, 5)
		equal(typeof(sequence), "ColorSequence", "type")
		local points = sequence.Keypoints
		assert(#points >= 4 and #points <= 20, "keypoint count")
		equal(points[1].Time, 0, "starts at the top")
		equal(points[#points].Time, 1, "ends at the bottom")
		for index = 2, #points do
			assert(points[index].Time > points[index - 1].Time, "times go down the button")
			assert(points[index].Value.R <= points[index - 1].Value.R + 1e-6, "never lighter further down")
		end
		for index, point in ipairs(points) do
			if point.Time <= 0.46 then
				near(brightness(sequence, index), 1, "the top half is at full colour")
			end
		end
		local lipStart = nil
		for _, point in ipairs(points) do
			if point.Value.R < 0.7 and lipStart == nil then lipStart = point.Time end
		end
		assert(lipStart, "a dark lip")
		near(lipStart, 1 - 5 / 52, "the lip is 5 px of 52")
		assert(points[#points].Value.R < 0.7, "the bottom is the dark lip")
		assert(brightness(sequence, 3) < 1, "the lower half is a little darker")
		local short = Style.glossSequence(4, 5)
		for _, point in ipairs(short.Keypoints) do
			if point.Value.R < 0.7 then
				assert(point.Time >= 1 - Style.HUD_SIZES.lipMax - 1e-6, "the lip never takes over a tiny button")
				break
			end
		end
		equal(#Style.glossSequence(nil, nil).Keypoints, #points, "bad numbers use the defaults")
		equal(#Style.glossSequence(0 / 0, 0 / 0).Keypoints, #points, "nan uses the defaults")
		equal(#Style.glossSequence(-3, 5).Keypoints, #points, "a negative height uses the default")
	end)

	case("UR-K4: progressFraction clamps to 0..1 and survives bad numbers; countText groups with dots", function()
		near(Style.progressFraction(50, 100), 0.5, "half")
		near(Style.progressFraction(0.25), 0.25, "max defaults to 1")
		equal(Style.progressFraction(150, 100), 1, "never over full")
		equal(Style.progressFraction(-5, 100), 0, "never under empty")
		equal(Style.progressFraction(5, 0), 0, "a max of 0")
		equal(Style.progressFraction(0 / 0, 100), 0, "nan value")
		equal(Style.progressFraction(5, 0 / 0), 0, "nan max")
		equal(Style.progressFraction(nil, 100), 0, "nil value")
		equal(Style.progressFraction(5, math.huge), 0, "infinite max")
		equal(Style.countText(0), "0", "zero")
		equal(Style.countText(250), "250", "three digits")
		equal(Style.countText(1250), "1.250", "thousands")
		equal(Style.countText(1000000), "1.000.000", "millions")
		equal(Style.countText(-7), "0", "never negative")
		equal(Style.countText(12.9), "12", "whole")
		equal(Style.countText(nil), "0", "nil")
		equal(Style.countText(math.huge), "999.999.999", "capped")
	end)

	case("UR-K5: motion adds bump; bump pops only without Efectos suaves; the P0.1 fields are unchanged", function()
		equal(Style.motion(true).bump, false, "reduced: no pop")
		equal(Style.motion(false).bump, true, "full: pop")
		equal(Style.motion(true).spin, false, "spin unchanged")
		equal(Style.motion(false).pulse, true, "pulse unchanged")
		local frame = Instance.new("Frame")
		equal(Style.bump(frame, true), false, "Efectos suaves")
		equal(frame:FindFirstChildOfClass("UIScale"), nil, "nothing added when reduced")
		equal(Style.bump(frame, false), true, "pops")
		local scale = frame:FindFirstChildOfClass("UIScale")
		assert(scale, "a scale to pop")
		equal(Style.bump(frame, false), true, "pops again")
		equal(#frame:GetChildren(), 1, "one scale reused")
		frame:Destroy()
	end)

	case("UR-K6: gloss dresses an existing button: layout and words kept, thick border, the lip gradient, press, tint", function()
		local gui = scratch()
		local button = Instance.new("TextButton")
		button.Name = "Bat"
		button.Text = "Bate (clic)"
		button.Position = UDim2.fromOffset(12, 34)
		button.Size = UDim2.fromOffset(120, 52)
		button.Visible = true
		button.ZIndex = 3
		button.Parent = gui
		equal(Style.gloss(button, "red"), button, "returns the button")
		equal(button.Name, "Bat", "name kept")
		equal(button.Text, "Bate (clic)", "text kept")
		equal(button.Position, UDim2.fromOffset(12, 34), "position kept")
		equal(button.Size, UDim2.fromOffset(120, 52), "size kept")
		equal(button.ZIndex, 3, "zindex kept")
		equal(button.BackgroundColor3, Style.GLOSS_TONES.red, "tone")
		equal(button:GetAttribute("WbGloss"), true, "marked glossy")
		local border = strokeOf(button, Enum.ApplyStrokeMode.Border)
		assert(border and border.Thickness >= 3, "thick border")
		equal(strokeCount(button), 1, "one stroke")
		local gradient = button:FindFirstChild("WbShade")
		assert(gradient and gradient:IsA("UIGradient"), "the gloss gradient")
		equal(gradient.Rotation, 90, "top to bottom")
		equal(#gradient.Color.Keypoints, #Style.glossSequence(52, Style.HUD_SIZES.lip).Keypoints, "the gloss sequence")
		assert(gradient.Color.Keypoints[#gradient.Color.Keypoints].Value.R < 0.7, "the dark lip")
		local uiGradients = 0
		for _, item in ipairs(button:GetChildren()) do
			if item:IsA("UIGradient") then uiGradients += 1 end
		end
		equal(uiGradients, 1, "one gradient")
		equal(button.Font, Enum.Font.FredokaOne, "display font")
		equal(button.TextStrokeTransparency, 0, "outlined words")
		assert(button:FindFirstChildOfClass("UIScale"), "press squash")
		assert(button:FindFirstChildOfClass("UICorner"), "rounded")
		Style.tint(button, "grey")
		equal(button.BackgroundColor3, Style.GLOSS_TONES.grey, "tint knows the glossy names")
		Style.gloss(button)
		equal(button.BackgroundColor3, Style.GLOSS_TONES.grey, "nil tone keeps the colour")
		equal(strokeCount(button), 1, "glossing twice adds nothing")
		local round = Instance.new("TextButton")
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0.5, 0)
		corner.Parent = round
		Style.gloss(round, "blue")
		equal(round:FindFirstChildOfClass("UICorner").CornerRadius.Scale, 0.5, "a round button stays round")
		round:Destroy()
		local plain = Style.kitButton(gui, "x", "green")
		Style.tint(plain, "off")
		equal(plain.BackgroundColor3, Style.COLORS.off, "a P0.1 button tints as before")
		gui:Destroy()
	end)

	case("UR-K7: kitGlossButton: a glossy kit button, words on a Label lifted over the lip, 44 px minimum", function()
		local gui = scratch()
		local button, label = Style.kitGlossButton(gui, "Jugar", "orange", "Play")
		equal(button.ClassName, "TextButton", "class")
		equal(button.Name, "Play", "name")
		equal(button.Parent, gui, "parent")
		equal(button.Text, "", "words on the Label")
		equal(button.BackgroundColor3, Style.GLOSS_TONES.orange, "tone")
		equal(button:GetAttribute("WbGloss"), true, "glossy")
		equal(strokeCount(button), 1, "one stroke on the button")
		equal(label.Name, "Label", "label")
		equal(label.Text, "Jugar", "words")
		equal(label.Size.Y.Scale, 1, "label height scale")
		equal(label.Size.Y.Offset, -Style.HUD_SIZES.lip, "the words sit above the lip")
		assert(strokeOf(label, Enum.ApplyStrokeMode.Contextual), "outlined words")
		equal(tapMin(button), Vector2.new(44, 44), "tap minimum")
		local default = Style.kitGlossButton(gui, "Ok")
		equal(default.Name, "Button", "default name")
		equal(default.BackgroundColor3, Style.GLOSS_TONES.green, "default green")
		gui:Destroy()
	end)

	case("UR-K8: kitCounter: a round glossy pill with an emoji and outlined number; setCounter changes the number", function()
		local gui = scratch()
		local counter, value = Style.kitCounter(gui, Style.ICONS.gold, Style.countText(1250), nil, "Gold")
		equal(counter.ClassName, "Frame", "class")
		equal(counter.Name, "Gold", "name")
		equal(counter.Parent, gui, "parent")
		equal(counter.BackgroundColor3, Style.GLOSS_TONES.dark, "dark navy by default")
		equal(counter:GetAttribute("WbGloss"), true, "glossy with the lip")
		equal(counter:FindFirstChildOfClass("UICorner").CornerRadius.Scale, 0.5, "a pill")
		assert(strokeOf(counter, Enum.ApplyStrokeMode.Border), "border")
		assert(counter.Size.Y.Offset >= 44, "readable height")
		equal(counter:FindFirstChild("Icon").Text, Style.ICONS.gold, "icon")
		equal(value.Name, "Value", "value name")
		equal(value.Text, "1.250", "number")
		equal(value.Font, Enum.Font.FredokaOne, "round font")
		assert(strokeOf(value, Enum.ApplyStrokeMode.Contextual), "outlined number")
		assert(value:FindFirstChildOfClass("UITextSizeConstraint"), "shrinks to fit")
		Style.setCounter(counter, "7")
		equal(value.Text, "7", "setCounter")
		Style.setCounter(nil, "8")
		local gold = Style.kitCounter(gui, "x", "0", "yellow")
		equal(gold.Name, "Counter", "default name")
		equal(gold.BackgroundColor3, Style.GLOSS_TONES.yellow, "a tone")
		gui:Destroy()
	end)

	case("UR-K9: progress bars: a round outlined track, a glossy fill, outlined words above it; glossBar dresses old bars", function()
		local gui = scratch()
		local track, fill, label = Style.kitProgressBar(gui, "Vida: 100 / 100", "green", "Health")
		equal(track.Name, "Health", "name")
		equal(track.Parent, gui, "parent")
		equal(fill.Name, "Fill", "fill name")
		equal(fill.Parent, track, "fill parent")
		equal(label.Name, "Text", "label name")
		equal(label.Text, "Vida: 100 / 100", "words")
		assert(label.ZIndex > fill.ZIndex, "the words draw over the fill")
		assert(strokeOf(label, Enum.ApplyStrokeMode.Contextual), "outlined words")
		local border = strokeOf(track, Enum.ApplyStrokeMode.Border)
		assert(border and border.Thickness >= 3, "thick outline")
		equal(track:FindFirstChildOfClass("UICorner").CornerRadius.Scale, 0.5, "rounded track")
		equal(fill:FindFirstChildOfClass("UICorner").CornerRadius.Scale, 0.5, "rounded fill")
		equal(fill.BackgroundColor3, Style.GLOSS_TONES.green, "fill tone")
		assert(fill:FindFirstChild("WbShade"), "fill gloss")
		assert(fill:FindFirstChild("WbShine"), "fill shine")
		near(Style.setProgress(track, 30, 100, "Vida: 30 / 100"), 0.3, "fraction")
		near(fill.Size.X.Scale, 0.3, "fill width")
		equal(fill.Visible, true, "shown")
		equal(label.Text, "Vida: 30 / 100", "words updated")
		equal(Style.setProgress(track, 0, 100), 0, "empty")
		equal(fill.Visible, false, "an empty fill hides")
		equal(label.Text, "Vida: 30 / 100", "nil text keeps the words")
		equal(Style.setProgress(track, 500, 100), 1, "never over full")
		local oldTrack = Instance.new("Frame")
		oldTrack.Size = UDim2.fromOffset(150, 8)
		local oldFill = Instance.new("Frame")
		oldFill.Name = "Fill"
		oldFill.BackgroundColor3 = Color3.fromRGB(200, 40, 40)
		oldFill.Parent = oldTrack
		Style.bar(oldTrack, oldFill)
		Style.glossBar(oldTrack, oldFill)
		equal(oldTrack.Size, UDim2.fromOffset(150, 8), "the old size is kept")
		equal(oldFill.BackgroundColor3, Color3.fromRGB(200, 40, 40), "nil tone keeps the script's colour")
		equal(oldFill:FindFirstChild("WbRainbow"), nil, "the old rainbow gives way to the gloss")
		Style.glossBar(oldTrack, oldFill, "rainbow")
		assert(oldFill:FindFirstChild("WbRainbow"), "rainbow tone")
		equal(oldFill:FindFirstChild("WbShade"), nil, "one gradient on the fill")
		equal(strokeCount(oldTrack), 1, "one stroke on the track")
		oldTrack:Destroy()
		gui:Destroy()
	end)

	case("UR-K10: panels and toasts: light, dark and blue looks with a thick border; dressPanel keeps the layout", function()
		local gui = scratch()
		for _, variant in ipairs({ "light", "dark", "blue" }) do
			local look = Style.panelLook(variant)
			assert(typeof(look.fill) == "Color3" and typeof(look.edge) == "Color3", variant)
			local panel = Style.kitPanel(gui, "P" .. variant, variant)
			equal(panel.BackgroundColor3, look.fill, variant .. " fill")
			local border = strokeOf(panel, Enum.ApplyStrokeMode.Border)
			assert(border and border.Thickness >= 4, variant .. " thick border")
			equal(border.Color, look.edge, variant .. " border colour")
			assert(panel:FindFirstChildOfClass("UIPadding"), variant .. " padding")
			equal(panel:GetAttribute("WbPanel"), variant, variant .. " attribute")
		end
		equal(Style.panelLook("nope"), Style.panelLook("light"), "unknown is light")
		equal(Style.panelLook("light").fill, Style.KIT_COLORS.inner, "the reference's pale panel")
		local old = Instance.new("Frame")
		old.Position = UDim2.fromOffset(5, 6)
		old.Size = UDim2.fromOffset(200, 80)
		Style.dressPanel(old, "dark", 0.1)
		equal(old.Position, UDim2.fromOffset(5, 6), "position kept")
		equal(old.Size, UDim2.fromOffset(200, 80), "size kept")
		near(old.BackgroundTransparency, 0.1, "transparency")
		equal(old:FindFirstChildOfClass("UIPadding"), nil, "no padding on a dressed frame")
		old:Destroy()
		local toast, label = Style.kitToast(gui, "¡Huevo guardado!", "Saved")
		equal(toast.Name, "Saved", "toast name")
		equal(toast.Parent, gui, "toast parent")
		equal(toast.BackgroundColor3, Style.KIT_COLORS.inner, "light toast")
		equal(label.Text, "¡Huevo guardado!", "toast words")
		equal(label.TextColor3, Style.KIT_COLORS.inkDark, "dark words on the light panel")
		equal(label.TextStrokeTransparency, 1, "no blur outline")
		equal(label.Font, Enum.Font.FredokaOne, "round font")
		assert(label:FindFirstChildOfClass("UITextSizeConstraint"), "fits")
		local loud = Style.kitLabel(gui, "Loud", "x")
		Style.panelText(loud)
		equal(loud:FindFirstChild("WbTextStroke").Transparency, 1, "panelText hides a loud outline")
		gui:Destroy()
	end)

	case("UR-K11: kitIconButton: round, glossy, 64 px, emoji Label, Caption under it; setCaption and setDimmed", function()
		local gui = scratch()
		local button, glyph, caption = Style.kitIconButton(gui, Style.ICONS.light, "Linterna", "yellow", "Flashlight")
		equal(button.ClassName, "TextButton", "class")
		equal(button.Name, "Flashlight", "name")
		equal(button.Parent, gui, "parent")
		equal(button.Size, UDim2.fromOffset(64, 64), "64 px")
		equal(tapMin(button), Vector2.new(44, 44), "tap minimum")
		equal(button:FindFirstChildOfClass("UICorner").CornerRadius.Scale, 0.5, "round")
		equal(button.BackgroundColor3, Style.GLOSS_TONES.yellow, "tone")
		equal(button:GetAttribute("WbGloss"), true, "glossy")
		equal(glyph.Name, "Label", "the icon is the Label")
		equal(glyph.Text, Style.ICONS.light, "icon")
		equal(caption.Name, "Caption", "caption name")
		equal(caption.Text, "Linterna", "caption words")
		equal(caption.Active, false, "taps go to the button")
		equal(caption.Position.Y.Scale, 1, "under the button")
		assert(caption.Position.Y.Offset >= 0, "not over the button")
		assert(caption.Size.X.Offset > 0, "wider than the button")
		assert(strokeOf(caption, Enum.ApplyStrokeMode.Contextual), "outlined caption")
		Style.setCaption(button, "Lista")
		equal(caption.Text, "Lista", "setCaption")
		Style.setCaption(nil, "x")
		Style.setLabel(button, Style.ICONS.pulse)
		equal(glyph.Text, Style.ICONS.pulse, "setLabel changes the icon")
		equal(Style.setDimmed(button, true), true, "dimmed")
		local dim = button:FindFirstChild("WbDim")
		assert(dim and dim.Visible, "a dark cover")
		equal(dim.Active, false, "the cover takes no taps")
		equal(button.Active, true, "the script still owns Active")
		equal(button:GetAttribute("WbDimmed"), true, "attribute")
		equal(Style.setDimmed(button, false), false, "lit again")
		equal(dim.Visible, false, "cover hidden")
		equal(#Style.kitIconButton(gui, "x").Name > 0, true, "defaults")
		gui:Destroy()
	end)

	case("UR-K12: the glossy kit draws with built-in pieces only: no image objects", function()
		for _, word in ipairs({ "ImageLabel", "ImageButton", "ImageColor3", "Image =" }) do
			assert(not source:find(word, 1, true), "the kit names " .. word)
		end
		for _, name in ipairs({ "gloss", "kitGlossButton", "kitCounter", "setCounter", "bump", "glossBar", "kitProgressBar",
			"setProgress", "dressPanel", "panelText", "kitPanel", "kitToast", "kitIconButton", "setCaption", "setDimmed",
			"glossColor", "glossSequence", "progressFraction", "countText", "panelLook" }) do
			assert(type(Style[name]) == "function", "helper " .. name)
		end
	end)

	return result
end
