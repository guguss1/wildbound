local data = { beast = "Pouncer", fps = 30, sourceHeight = 7.1668, restPos = {}, parents = {}, actions = {} }
local ALPHA = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local VALUE = {}
for i = 1, #ALPHA do VALUE[string.byte(ALPHA, i)] = i - 1 end
local MAXQ = 4095
local T_RANGE = 12
local function dec(s, at, range)
	return (VALUE[string.byte(s, at)] * 64 + VALUE[string.byte(s, at + 1)]) / MAXQ * 2 * range - range
end
local function quat(x, y, z)
	return math.sqrt(math.max(0, 1 - x * x - y * y - z * z))
end
-- Armature-space rest frames.
local restLocal, restWorld = {}, {}
for i, v in ipairs(REST) do
	restLocal[i] = CFrame.new(v[1], v[2], v[3], v[5], v[6], v[7], v[4])
	restWorld[i] = (PARENT[i] > 0 and restWorld[PARENT[i]] or CFrame.identity) * restLocal[i]
	local p = restWorld[i].Position
	data.restPos[BONES[i]] = { p.X, p.Y, p.Z }
	data.parents[BONES[i]] = PARENT[i] > 0 and BONES[PARENT[i]] or false
end
local function pack(cf)
	local axis, angle = cf:ToAxisAngle()
	local s = math.sin(angle / 2)
	local p = cf.Position
	return { p.X, p.Y, p.Z, math.cos(angle / 2), axis.X * s, axis.Y * s, axis.Z * s }
end
for name, packed in pairs(PACKED) do
	local keys = {}
	for k, s in ipairs(packed.keys) do
		local localPose, at = {}, 1
		for b = 1, #packed.bones, 2 do
			local bone, moves = packed.bones[b], packed.bones[b + 1] == 1
			local qx, qy, qz = dec(s, at, 1), dec(s, at + 2, 1), dec(s, at + 4, 1)
			at += 6
			local tx, ty, tz = 0, 0, 0
			if moves then
				tx, ty, tz = dec(s, at, T_RANGE), dec(s, at + 2, T_RANGE), dec(s, at + 4, T_RANGE)
				at += 6
			end
			localPose[bone] = CFrame.new(tx, ty, tz, qx, qy, qz, quat(qx, qy, qz))
		end
		local world, p = {}, {}
		for i = 1, #BONES do
			world[i] = (PARENT[i] > 0 and world[PARENT[i]] or CFrame.identity) * restLocal[i] * (localPose[i] or CFrame.identity)
			p[BONES[i]] = pack(world[i] * restWorld[i]:Inverse())
		end
		keys[k] = { t = packed.times[k], p = p }
	end
	data.actions[name] = { length = packed.length, keys = keys }
end
return data
